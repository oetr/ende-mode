(ert-deftest ende-compact-policies-and-budgets ()
  (let ((ende-auto-compact nil)
        (ende-agent-auto-compact '(:tokens 500)))
    (should-not (ende-compact-policy 'chat))
    (should (equal (ende-compact-policy 'agent) '(:tokens 500)))
    (should-not (ende-compact-policy 'edit))
    (setq ende-auto-compact '(:percent 80 :fallback-tokens 900))
    (should (equal (ende-compact-policy 'chat) ende-auto-compact))
    (should-not (eq (ende-compact-policy 'chat) ende-auto-compact))
    (dolist (invalid '(t 100 (:tokens 0) (:tokens -1) (:tokens 1.5)
                       (:tokens "100") (:tokens 100 :tokens 200)
                       (:tokens 100 :percent 80) (:percent 80)
                       (:percent 0 :fallback-tokens 100)
                       (:percent 100 :fallback-tokens 100)
                       (:percent 100.0 :fallback-tokens 100)
                       (:percent 100.1 :fallback-tokens 100)
                       (:percent 1.0e+INF :fallback-tokens 100)
                       (:percent 80 :fallback-tokens 0)
                       (:percent 80 :fallback-tokens nil)
                       (:percent 80 :fallback-tokens 100 :tokens 100)
                       (:percent 80 :unknown 100) (:tokens) (:tokens . 100)))
      (setq ende-auto-compact invalid)
      (should-error (ende-compact-policy 'chat))
      (should-error (ende-compact-budget nil invalid))))
  (dolist (case '((nil nil nil)
                  (nil (:percent 80 :fallback-tokens 900)
                       (:trigger 900 :capacity nil :target 540))
                  ((:context-window 1000 :output-tokens 300)
                   (:percent 80 :fallback-tokens 900)
                   (:trigger 700 :capacity 700 :target 420))
                  ((:context-window 1000 :max-output-tokens 900)
                   (:percent 80 :fallback-tokens 900)
                   (:trigger 800 :capacity 1000 :target 480))
                  ((:context-window 1000 :output-tokens 1100) (:tokens 900)
                   (:trigger 0 :capacity 0 :target 0))
                  ((:context-window 1000 :output-tokens 200) (:tokens 5000)
                   (:trigger 800 :capacity 800 :target 480))
                  ((:context-window 1000 :max-input-tokens 600 :output-tokens 100)
                   (:percent 80 :fallback-tokens 900)
                   (:trigger 600 :capacity 600 :target 360))
                  ((:max-input-tokens 1000 :output-tokens 200)
                   (:percent 80 :fallback-tokens 900)
                   (:trigger 800 :capacity 1000 :target 480))
                  ((:api anthropic-messages :max-input-tokens 1000
                    :max-output-tokens 900 :output-tokens 300)
                   (:percent 80 :fallback-tokens 900)
                   (:trigger 700 :capacity 700 :target 420))
                  ((:api anthropic-messages :max-input-tokens 1000 :output-tokens 300)
                   (:tokens 5000)
                   (:trigger 700 :capacity 700 :target 420))
                  ((:api anthropic-messages :max-input-tokens 1000 :output-tokens 1100)
                   (:tokens 900)
                   (:trigger 0 :capacity 0 :target 0))
                  ((:api anthropic-messages :max-input-tokens 1000 :max-output-tokens 900)
                   (:percent 80 :fallback-tokens 900)
                   (:trigger 800 :capacity 1000 :target 480))
                  ((:api anthropic-messages :context-window 1000
                    :max-input-tokens 600 :output-tokens 100)
                   (:percent 80 :fallback-tokens 900)
                   (:trigger 600 :capacity 600 :target 360))
                  ((:api anthropic-messages :max-output-tokens 900 :output-tokens 300)
                   (:percent 80 :fallback-tokens 900)
                   (:trigger 900 :capacity nil :target 540))
                  ((:service openai-codex :context-window 1000 :output-tokens 900)
                   (:percent 99 :fallback-tokens 900)
                   (:trigger 800 :capacity 800 :target 480))
                  ((:service openai-codex :max-input-tokens 1000 :output-tokens 900)
                   (:percent 99 :fallback-tokens 900)
                   (:trigger 800 :capacity 800 :target 480))
                  ((:context-window 1001) (:percent 50 :fallback-tokens 900)
                   (:trigger 500 :capacity 1001 :target 300))
                  ((:context-window 1000) (:percent 0.5 :fallback-tokens 900)
                   (:trigger 5 :capacity 1000 :target 3))
                  (nil (:tokens 1) (:trigger 1 :capacity nil :target 0))))
    (pcase-let ((`(,profile ,policy ,expected) case))
      (should (equal (ende-compact-budget profile policy) expected)))))

(ert-deftest ende-compact-resolved-limits-and-selected-cache ()
  (let* ((ende-custom-providers
          '((local :api openai-chat-completions :auth-method none
                   :base-url "http://localhost:8080/v1" :models ("small" "large" "input-only")
                   :context-window 500 :model-settings (("small" :context-window 1000)))))
         (ende-builtin-provider-settings nil)
         (ende-default-output-tokens nil)
         (ende-provider-discovery-ttl nil)
         (ende-provider--catalog-cache (make-hash-table :test #'equal))
         (profile (ende-provider-config-resolve 'local "small"))
         (large (ende-provider-config-resolve 'local "large"))
         (anthropic (ende-plist-merge profile '(:model "input-only" :context-window nil
                                               :api anthropic-messages :output-tokens 300)))
         (catalog (ende-provider--catalog-from-payload
                   (ende-protocol-json-read-string
                    "{\"data\":[{\"id\":\"small\",\"context_length\":2000,\"max_input_tokens\":600},
                                {\"id\":\"large\",\"context_length\":3000,\"max_input_tokens\":400},
                                {\"id\":\"input-only\",\"max_input_tokens\":1000,\"max_output_tokens\":900}]}")))
         (policy '(:percent 80 :fallback-tokens 900))
         (key (ende-provider--catalog-key profile)))
    (setq catalog (plist-put catalog :time (float-time)))
    (puthash key catalog ende-provider--catalog-cache)
    (puthash (ende-provider--catalog-key anthropic) catalog ende-provider--catalog-cache)
    (cl-letf (((symbol-function 'ende-provider--start-live-model-request)
               (lambda (&rest _) (ert-fail "Budgeting started discovery"))))
      (dolist (case (list (list profile '(:trigger 800 :capacity 1000 :target 480))
                         (list large '(:trigger 400 :capacity 500 :target 240))
                         (list (plist-put (copy-sequence profile) :output-tokens 300)
                               '(:trigger 700 :capacity 700 :target 420))
                         (list (plist-put (copy-sequence profile) :context-window nil)
                               '(:trigger 600 :capacity 600 :target 360))
                         (list (plist-put (copy-sequence large) :context-window nil)
                               '(:trigger 400 :capacity 400 :target 240))
                         (list (ende-plist-merge profile '(:model "input-only" :context-window nil))
                               '(:trigger 800 :capacity 1000 :target 480))
                         (list anthropic
                               '(:trigger 700 :capacity 700 :target 420))
                         (list '(:models ("small") :model "small")
                               '(:trigger 900 :capacity nil :target 540))
                         (list (ende-plist-merge profile '(:model "missing" :context-window nil))
                               '(:trigger 900 :capacity nil :target 540))))
        (let* ((selected (car case))
               (before (copy-tree selected))
               (budget (ende-compact-budget selected policy))
               (expected (cadr case)))
          (should (equal budget expected))
          (should (equal selected before))))
      (let ((ende-provider-discovery-ttl 1))
        (setf (plist-get catalog :time) 0)
        (should-not (plist-get (ende-compact-budget
                               (plist-put (copy-sequence profile) :context-window nil) policy)
                              :capacity))))
    (should (= (hash-table-count ende-provider--catalog-cache) 2))
    (should (eq (gethash key ende-provider--catalog-cache) catalog))))

(ert-deftest ende-compact-inclusive-request-usage ()
  (dolist (case '((openai-chat-completions
                   (:prompt_tokens 100 :prompt_tokens_details (:cached_tokens 80)
                    :completion_tokens 900 :total_tokens 1000) 100)
                  (openai-chat-completions
                   (:prompt_tokens 100 :prompt_cache_hit_tokens 80 :prompt_cache_miss_tokens 20) 100)
                  (openai-responses (:input_tokens 100 :input_tokens_details (:cached_tokens 80)) 100)
                  (anthropic-messages
                   (:input_tokens 10 :cache_read_input_tokens 80 :cache_creation_input_tokens 20) 110)
                  (anthropic-messages (:input_tokens 0 :cache_read_input_tokens 80) 80)
                  (anthropic-messages (:input_tokens 0) 0)
                  (openai-responses (:input_tokens 0) 0)
                  (openai-chat-completions (:prompt_tokens 0) 0)
                  (openai-responses (:total_tokens 1000) nil)
                  (openai-responses (:input_tokens -1) nil)
                  (openai-responses (:input_tokens 1.5) nil)
                  (anthropic-messages (:input_tokens 10 :cache_read_input_tokens -1) nil)
                  (anthropic-messages (:cache_read_input_tokens 80) nil)
                  (unknown (:input_tokens 10) nil)))
    (pcase-let ((`(,protocol ,usage ,expected) case))
      (dolist (input (list usage (ende-protocol-json-read-string (json-encode usage))))
        (should (equal (ende-compact-input-tokens input protocol) expected))))))

(ert-deftest ende-compact-estimates-full-payload-with-bounded-opaque-parts ()
  (let* ((text (make-string 600 ?x))
         (base (list (cons "user" text)))
         (baseline (ende-compact-estimate base nil))
         (schema (list (list :type "function" :function
                             (list :name "test" :description text :parameters
                                   '(:type "object" :properties (:path (:type "string"))))))))
    (should (>= baseline 200))
    (dolist (message (list (cons "system" text)
                          (list :role "assistant" :content text :reasoning-content text)
                          (list :role "assistant" :content "" :tool-calls
                                (list (list :id "call" :name "test" :arguments text)))
                          (list :role "tool" :tool-call-id "call" :content text)
                          (list :role "assistant" :protocol-items
                                (cons 'openai-responses (vector (list :text text))))))
      (should (>= (- (ende-compact-estimate (append base (list message)) nil) baseline) 200)))
    (should (>= (- (ende-compact-estimate base schema) baseline) 200))
    (let ((before (copy-tree base)))
      (ende-compact-estimate base schema)
      (should (equal base before)))
    (dolist (part (list '(:type :image :path "/nonexistent/image.png" :width 2048 :height 2048)
                        '(:type :source :path "/nonexistent/source")
                        (list :type "input_image" :image_url
                              (concat "data:image/png;base64," (make-string 100000 ?a)))
                        (list :type "thinking" :signature (make-string 100000 ?a))
                        (list :type "reasoning" :encrypted_content (make-string 100000 ?a))))
      (let ((estimate (ende-compact-estimate (list (list :role "user" :content (list part))) nil)))
        (should (<= 16384 estimate 17000))))
    (should (> (ende-compact-estimate
                '((:role "assistant" :protocol-opaque ((:id "a") (:id "b")))) nil)
               32768))
    (let ((cycle (list "cycle")))
      (setcdr cycle cycle)
      (should (< (ende-compact-estimate cycle nil) 17000)))))

(ert-deftest ende-compact-summary-preserves-prefix-and-host-gate ()
  (let* ((profile '(:model "test" :output-tokens 200 :job-id 7
                   :codex-session-id "session" :request-phase work
                   :tool-definitions
                   (((:type . "function")
                     (:function . ((:name . "read_file") (:description . "Read")
                                   (:parameters . ((:type . "object")))))))))
         (messages (list '("system" . "Stable root")
                         (cons "user" (make-string 3000 ?x))
                         (ende-content-capabilities "(capabilities (self (tools read_file)))")
                         '(:role "assistant" :content "" :tool-calls
                           ((:id "c" :name "read_file" :arguments "{\"path\":\"a.el\"}")))
                         '(:role "tool" :tool-call-id "c" :content "Useful result")
                         '("assistant" . "Work completed")))
         (original (copy-tree messages))
         (job (ende--make-job :id 7 :state 'running :profile profile :request-phase 'work))
         (ende--active-jobs (list job))
         request sent-profile summary failure
         (ende-llm-function
          (lambda (input callbacks &optional options)
            (setq request input sent-profile options)
            (funcall (plist-get callbacks :on-done) '(:content "Useful summary" :finish-reason "stop")))))
    (ende-compact-summarize job messages '(:capacity 10000 :target 300)
                            (lambda (value) (setq summary value))
                            (lambda (value) (setq failure value)))
    (should (equal summary "Useful summary"))
    (should-not failure)
    (should (equal (butlast request 2) original))
    (should (equal messages original))
    (should (eq (ende-job-profile job) profile))
    (should (eq (ende-job-request-phase job) 'work))
    (should (eq (plist-get sent-profile :request-phase) 'compact))
    (should (equal (plist-put (copy-sequence sent-profile) :request-phase 'work) profile))
    (should (equal (ende-content-role (car (last request 2))) "user"))
    (should (equal (car (last request))
                   (ende-content-capabilities
                    (ende-chat-config-capabilities '(:access-policy (:active-tools nil))))))
    (dolist (spec '((ende-llm--request-body :messages)
                    (ende-responses--request-body :input)
                    (ende-codex--request-body :input)
                    (ende-messages--request-body :messages)))
      (let* ((before (funcall (car spec) messages profile))
             (after (funcall (car spec) request sent-profile))
             (prefix (alist-get (cadr spec) before)))
        (should (equal (json-encode prefix)
                       (json-encode (cl-subseq (alist-get (cadr spec) after) 0 (length prefix)))))
        (dolist (key '(:system :tools :tool_choice :max_tokens :max_output_tokens :reasoning))
          (should (equal (alist-get key before) (alist-get key after))))))
    (let ((ende-tools--request-phase 'compact)
          (ende-tools--report-activity-function (lambda (&rest _) (ert-fail "Tool executed"))))
      (dolist (name (cons 'unknown (mapcar #'car ende-tools--registry)))
        (should-not (ende-tools-phase-allows-p name 'compact)))
      (should-not (plist-get (ende-tool-call 'about_thinking '(:title "No" :status "No")) :ok)))))

(ert-deftest ende-compact-summary-bounded-chunks-and-context-fallback ()
  (dolist (mode '(oversized character-limit context-rejection fixed-overhead no-reduction))
    (ert-info ((symbol-name mode))
      (let* ((root (cons "system" (if (eq mode 'fixed-overhead) (make-string 9000 ?s) "Stable root")))
             (messages (list root
                             '(:role "assistant" :content "" :tool-calls
                               ((:id "giant" :name "read_file" :arguments "{\"path\":\"large.el\"}")))
                             (list :role "tool" :tool-call-id "giant"
                                   :content (make-string (if (eq mode 'context-rejection) 1500 15000) ?λ))
                             '(:role "user" :content
                               ((:type :image :path "/missing" :data "NOT-FOR-THE-MODEL")))))
             (original (copy-tree messages))
             (profile '(:model "test" :tool-definitions
                        (((:type . "function") (:function . ((:name . "read_file")))))))
             (job (ende--make-job :state 'running :profile profile))
             (ende--active-jobs (list job))
             (ceiling (if (memq mode '(character-limit context-rejection)) 30000 2400))
             (ende-max-request-chars (when (eq mode 'character-limit) 6000))
             (count 0) requests summary failure
             (ende-llm-function
              (lambda (input callbacks &optional options)
                (cl-incf count)
                (push input requests)
                (should (equal (car input) root))
                (should (equal (plist-get options :tool-definitions)
                               (plist-get profile :tool-definitions)))
                (should (<= (ende-compact--request-size input (plist-get options :tool-definitions)) ceiling))
                (if (and (eq mode 'context-rejection) (= count 1))
                    (funcall (plist-get callbacks :on-error)
                             (ende-error-create :kind 'provider :details '(:code "context_length_exceeded")))
                  (funcall (plist-get callbacks :on-done)
                           (list :content (if (eq mode 'no-reduction)
                                              (ende-content-body (cadr input))
                                            "Facts retained from history.")))))))
        (ende-compact-summarize job messages (list :trigger ceiling :target 30)
                                (lambda (value) (setq summary value))
                                (lambda (value) (setq failure value)))
        (should (equal messages original))
        (should (eq (ende-job-state job) 'running))
        (should (<= count ende-compact--max-requests))
        (if (memq mode '(fixed-overhead no-reduction))
            (progn
              (should-not summary)
              (should failure)
              (when (eq mode 'fixed-overhead)
                (should (= count 0))
                (should (string-match-p "fixed system, schemas and controls"
                                        (ende-error-display-message failure)))))
          (should-not failure)
          (should summary)
          (should (> count 1))
          (let ((sources (mapconcat (lambda (input) (ende-content-body (cadr input)))
                                   (reverse (if (eq mode 'context-rejection) (butlast requests) requests)) "")))
            (should (string-match-p "large.el" sources))
            (should (string-match-p "Tool result giant" sources))
            (should (string-match-p "contents not inspected" sources))
            (should-not (string-match-p "NOT-FOR-THE-MODEL" sources))))))))

(ert-deftest ende-compact-summary-isolation-settlement-and-acceptance ()
  (dolist (outcome '((:content "Summary" :finish-reason "end_turn")
                     (:content " ")
                     (:content "Partial" :finish-reason "length")
                     (:content "Partial" :finish-reason "max_tokens")
                     (:content "Partial" :status "incomplete")
                     (:content "Refused" :refusal "No")
                     (:content "Unsafe" :tool-calls ((:name "about_thinking")))
                     (:content "Partial" :protocol-items
                      (openai-responses (:type "message" :status "incomplete")))
                     (:content "Refused" :protocol-items
                      (openai-responses (:type "message" :content ((:type "refusal" :refusal "No")))))
                     service-error cancel chunk-cancel supersede))
    (ert-info ((format "%S" outcome))
      (let* ((transcript (ende-transcript-create))
             (job (ende--make-job :state 'running :execution-generation 1
                                 :profile '(:model "test") :request-phase 'work
                                 :transcript transcript :last-usage '(:input_tokens 42)
                                 :metadata '(:model "work")))
             (ende--active-jobs (list job))
             (before (copy-tree (ende-job-metadata job)))
             callbacks events done errors (cancelled 0) (calls 0)
             (ende-job-event-functions (list (lambda (_job event) (push event events))))
             (ende-llm-function
              (lambda (_input handlers &optional _profile)
                (cl-incf calls)
                (setq callbacks handlers)
                (funcall (plist-get handlers :on-start) (lambda () (cl-incf cancelled))))))
        (ende-compact-summarize
         job (list '("system" . "Root") (cons "user" (make-string 3000 ?x)))
         (list :trigger (if (eq outcome 'chunk-cancel) 1500 10000) :target 10)
         (lambda (value) (push value done)) (lambda (value) (push value errors)))
        (when (eq outcome 'chunk-cancel)
          (funcall (plist-get callbacks :on-done) '(:content "First fragment summary")))
        (dolist (event '((:type :delta :channel :content :text "Private summary")
                         (:type :usage :usage (:input_tokens 999))
                         (:type :metadata :metadata (:model "summary"))
                         (:type :response-restarted :text "Private restart")
                         (:type :status :status "Summarizing")))
          (funcall (plist-get callbacks :on-event) event))
        (cond
         ((memq outcome '(cancel chunk-cancel))
          (setf (ende-job-state job) 'cancelled)
          (funcall (ende-job-cancel-function job)))
         ((eq outcome 'supersede) (cl-incf (ende-job-execution-generation job))))
        (if (eq outcome 'service-error)
            (funcall (plist-get callbacks :on-error) (ende-error-create :kind 'transport :message "Unavailable"))
          (funcall (plist-get callbacks :on-done) (if (symbolp outcome) '(:content "Late") outcome)))
        (funcall (plist-get callbacks :on-done) '(:content "Duplicate"))
        (funcall (plist-get callbacks :on-error) "Late error")
        (funcall (plist-get callbacks :on-event) '(:type :status :status "Late status"))
        (should (= calls (if (eq outcome 'chunk-cancel) 2 1)))
        (should (cl-every (lambda (event) (eq (plist-get event :type) :status)) events))
        (should-not (equal (plist-get (car events) :status) "Late status"))
        (should (equal (ende-job-last-usage job) '(:input_tokens 42)))
        (should (equal (ende-job-metadata job) before))
        (should (eq (ende-job-transcript job) transcript))
        (should-not (ende-transcript-entries transcript))
        (cond
         ((memq outcome '(cancel chunk-cancel supersede))
          (should-not done) (should-not errors)
          (should (= cancelled (if (memq outcome '(cancel chunk-cancel)) 1 0))))
         ((equal (plist-get (and (listp outcome) outcome) :content) "Summary")
          (should (equal done '("Summary"))) (should-not errors))
         (t (should-not done) (should (= (length errors) 1))))
        (unless (memq outcome '(cancel chunk-cancel))
          (should (eq (ende-job-state job) 'running)))))))

(ert-deftest ende-compact-work-gate-failure-and-observation ()
  (dolist (mode '(reduce fail identical-refresh changed-refresh unknown oversized stale cancel generation drop-recent))
    (let* ((messages (list '("system" . "Root") '("user" . "Task")
                           (cons "assistant" (make-string (if (eq mode 'drop-recent) 12000 6000) ?x))))
           (profile (list :api 'anthropic-messages :model "work"
                          :context-window (unless (eq mode 'unknown)
                                            (if (eq mode 'drop-recent) 3000 10000))))
           (job (ende--make-job :id 7 :state 'running :type 'agent :profile profile :execution-generation 0))
           (ende--active-jobs (list job))
           (state (ende-compact-state-create :policy '(:tokens 1000)))
           (live messages)
           recent-selections
           (callbacks (list :compaction-context
                            (lambda (owner input)
                              (ende-agent--compaction-context owner input (cadr messages)))
                            :compaction-messages
                            (lambda (snapshot summary include-recent)
                              (push include-recent recent-selections)
                              (ende-agent--compaction-messages snapshot summary include-recent))
                            :apply-compaction #'ende-agent--apply-compaction
                            :refresh-context (lambda (_owner _input) live)))
           pending sent warnings)
      (should (= (ende-compact-size state messages nil) (ende-compact-estimate messages nil)))
      (ende-compact-observe state profile messages
                            '(:input_tokens 10 :cache_read_input_tokens 900 :cache_creation_input_tokens 90))
      (should (= (ende-compact-work-size state profile messages) 1000))
      (let ((grown (append messages '(("assistant" . "More work")))))
        (should (= (ende-compact-work-size state profile grown)
                   (+ 1000 (- (ende-compact-estimate grown nil) (ende-compact-estimate messages nil))))))
      (should (= (ende-compact-work-size state (plist-put (copy-sequence profile) :model "other") messages)
                 (ende-compact-estimate messages nil)))
      (when (eq mode 'drop-recent)
        (setq messages
              (append messages
                      (list '(:role "assistant" :content "" :tool-calls ((:id "one" :name "read_file" :arguments "{}")))
                            (list :role "tool" :tool-call-id "one" :content (make-string 900 ?r))))
              live messages))
      (cl-letf (((symbol-function 'ende-compact-summarize)
                 (lambda (_job input _budget done failed &optional _instructions)
                   (should (eq input messages))
                   (setq pending (list done failed))))
                ((symbol-function 'display-warning)
                 (lambda (&rest args) (push args warnings))))
        (ende-compact-before-send job messages state callbacks (lambda (input) (push input sent)))
        (should pending)
        (pcase mode
          ('stale (setf (ende-job-profile job) '(:model "changed")))
          ('cancel (setf (ende-job-state job) 'cancelled))
          ('generation (cl-incf (ende-job-execution-generation job)))
          ('identical-refresh (setq live (copy-tree messages)))
          ('changed-refresh (setq live (append messages '(("user" . "Changed task"))))))
        (if (memq mode '(fail identical-refresh changed-refresh unknown stale cancel generation))
            (funcall (cadr pending) "Summary unavailable")
          (funcall (car pending) (pcase mode
                                  ('oversized (make-string 40000 ?s))
                                  ('drop-recent (make-string 8000 ?s))
                                  (_ "Useful summary"))))
        (cond
         ((memq mode '(reduce drop-recent))
          (should (= (length sent) 1))
          (when (eq mode 'drop-recent)
            (should (equal (reverse recent-selections) '(t nil))))
          (should (equal (cadr (car sent))
                         (cons "assistant" (if (eq mode 'drop-recent) (make-string 8000 ?s) "Useful summary"))))
          (should-not (cl-find "tool" (car sent) :key #'ende-content-role :test #'equal))
          (should (= (length (ende-transcript-entries (ende-job-transcript job))) 1)))
         ((memq mode '(fail identical-refresh oversized))
          (should (= (length sent) 1))
          (should (eq (car sent) messages))
          (should warnings)
          (should-not (ende-job-transcript job)))
         (t (should-not sent)))))))

(ert-deftest ende-compact-child-initial-and-tool-continuations ()
  (dolist (nested '(nil t))
    (let* ((ende-auto-compact nil)
           (ende-agent-auto-compact '(:tokens 1000))
           (messages (list '("system" . "System") '("user" . "Verbatim task")
                           (cons "assistant" (make-string 6000 ?x))))
           (job (ende--make-job :id 7 :type 'agent :state 'running :request-phase 'work
                               :parent (when nested (ende--make-job :type 'agent))
                               :profile '(:api openai-chat-completions :model "test" :context-window 20000)))
           (ende--active-jobs (list job))
           (ende-agent-max-tool-rounds 1)
           ende-llm-function
           (ende-test--calls nil)
           (ende-test--fake-responses nil)
           (executed 0) final)
      (setq ende-llm-function
            (ende-test--fake-llm
             '("Initial summary"
               (:usage (:prompt_tokens 100) :tool-calls
                ((:id "one" :name "about_thinking" :arguments "{}")
                 (:id "two" :name "about_thinking" :arguments "{}")))
               "Tool summary" "Done") t))
      (ende-agent-run
       job messages '(:active-tools (about_thinking))
       (list :omit-source-metadata t :tool-calls #'ende-agent--tool-call-list
             :tool-name (lambda (call) (plist-get call :name))
             :execute-tool (lambda (_call _configuration done)
                             (cl-incf executed) (funcall done (make-string 6000 ?r)))
             :assistant-message #'ende-agent--assistant-message
             :tool-result-message #'ende-agent--tool-result-message
             :on-final (lambda (_job result _messages) (setq final result))))
      (dotimes (index 4)
        (ende-test--wait-for (lambda () (> (length ende-test--calls) index)))
        (ende-test--complete-call (nth index ende-test--calls)))
      (should (equal (plist-get final :content) "Done"))
      (should (= executed 2))
      (should (equal (mapcar (lambda (call) (plist-get (plist-get call :options) :request-phase))
                            ende-test--calls) '(compact work compact work)))
      (should (eq (ende-transcript-initial-messages (ende-job-transcript job)) messages))
      (should (equal (ende-transcript-task (ende-job-transcript job)) "Verbatim task"))
      (should (= (ende-transcript-round (ende-job-transcript job)) 2))
      (should (= (cl-count 'context-fence (ende-transcript-entries (ende-job-transcript job))
                          :key #'ende-transcript-entry-kind) 2))
      (should (= (cl-count 'tool-result (ende-transcript-entries (ende-job-transcript job))
                          :key #'ende-transcript-entry-kind) 2)))))

