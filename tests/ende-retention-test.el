;;; ende-retention-test.el --- Family lifetime integration -*- lexical-binding: t; -*-

(require 'ende-chat-test-helpers)

(ert-deftest ende-test/retention-owns-complete-families-until-eviction ()
  (ende-test--reset)
  (let* ((ende-queue-finished-limit 1)
         (ende-llm-function (ende-test--fake-llm nil t))
         (ende--queue-suspended t)
         (ende--job-handlers (cons '(insert . ignore) ende--job-handlers))
         root child old-family child-work child-buffer child-target child-transcript active second)
    (unwind-protect
        (with-temp-buffer
          (insert "user-owned source")
          (setq root (ende-enqueue (ende-test--dashboard-request
                                   ende-test--dashboard-profile)))
          (setq old-family (ende-job-family root))
          (let ((ende--queue-suspended nil)) (ende-process-next))
          (setq child
                (ende-job-publish-child
                 root (list 'agent :profile ende-test--dashboard-profile
                            :instruction '(:task "Retained child")
                            :prepare #'ende-agent-private-target)
                 (ende-job-next-child-path root)))
          (should-not (ende-job-work-buffer child))
          (setq child-buffer (ende-job-owned-buffer child)
                child-target (ende-job-target child)
                child-transcript (ende-job-ensure-transcript child))
          (should (buffer-live-p child-buffer))
          (should (eq (ende-target-buffer child-target) child-buffer))
          (ende-job-ensure-transcript root)
          (ende-transcript-begin-response child-transcript)
          (ende-transcript-accept child-transcript '(:content "child answer") nil nil t)
          (ende-history-begin child '(("user" . "private prompt")))
          (ende--job-settle child 'completed "child answer")
          (should-not (buffer-live-p child-buffer))
          (should-not (ende-job-target child))
          (should-not (ende-job-owned-buffer child))
          (should-not (ende-job-owned-buffer-hook child))
          (should-not (marker-buffer (ende-target-cursor-marker child-target)))
          (should-not (ende-job-children root))
          (should (= (length (ende-job-family-members old-family)) 2))
          (should (eq child (ende-queue-retained-job-by-id (ende-job-id child))))
          (should-not ende--finished-families)
          (ende-job-finish root "root answer")
          (should (equal ende--finished-families (list old-family)))
          (setq child-work (ende-work-buffer-open child))
          (should (buffer-live-p child-work))
          (should (string-match-p "child answer" (with-current-buffer child-work (buffer-string))))
          (kill-buffer child-work)
          (should-not (ende-job-work-buffer child))
          (should (eq child-transcript (ende-job-transcript child)))
          (should (eq child (ende-queue-retained-job-by-id (ende-job-id child))))
          (setq child-work (ende-work-buffer-open child))
          (should (string-match-p "child answer" (with-current-buffer child-work (buffer-string))))
          (setq active (ende-enqueue (ende-test--dashboard-request
                                     ende-test--dashboard-profile))
                second (ende-enqueue (ende-test--dashboard-request
                                     ende-test--dashboard-profile)))
          (ende--job-settle second 'completed "newest")
          (should-not (gethash (ende-job-id child) ende--retained-jobs))
          (should-not (gethash (ende-job-id root) ende--retained-jobs))
          (should-not (buffer-live-p child-work))
          (should-not (ende-job-work-buffer child))
          (should-not (ende-job-transcript child))
          (should-not (ende-job-transcript root))
          (should-not (ende-job-family-members old-family))
          (should-not (ende-job-instruction child))
          (should (eq active (gethash (ende-job-id active) ende--retained-jobs)))
          (should (buffer-live-p (current-buffer)))
          (should (string-prefix-p "user-owned source" (buffer-string)))
          (with-current-buffer (ende-history--buffer)
            (should-not (string-match-p "private prompt\\|child answer" (buffer-string))))
          (let ((ende-queue-finished-limit 0))
            (ende--job-settle active 'cancelled)
            (should-not ende--finished-families)))
      (ende-test--reset))))

(ert-deftest ende-test/failed-publication-leaves-no-retained-work ()
  (ende-test--reset)
  (let ((ende--queue-suspended t) job work buffer target)
    (unwind-protect
        (with-temp-buffer
          (insert "source")
          (let* ((prepare (lambda (prepared)
                            (setq job prepared)
                            (ende-agent-private-target prepared)
                            (should-not (ende-job-work-buffer prepared))
                            (setq buffer (ende-job-owned-buffer prepared)
                                  target (ende-job-target prepared)
                                  work (ende-work-buffer-open prepared))))
                 (request (list 'agent :profile ende-test--dashboard-profile
                                :instruction '(:task "Unpublished task") :prepare prepare)))
            (cl-letf (((symbol-function 'ende--queue-insert-family-member)
                       (lambda (_) (error "publication failed"))))
              (should-error (ende-enqueue request)))
            (should-not (gethash (ende-job-id job) ende--retained-jobs))
            (should-not (buffer-live-p work))
            (should-not (buffer-live-p buffer))
            (should-not (ende-job-owned-buffer job))
            (should-not (ende-job-owned-buffer-hook job))
            (should-not (ende-job-target job))
            (should-not (marker-buffer (ende-target-cursor-marker target)))
            (should (equal (buffer-string) "source"))
            (should-not ende-queue)
            (should-not ende--source-buffer-jobs)))
      (ende-test--reset))))

(ert-deftest ende-test/retention-owned-target-disposal-does-not-cancel-or-kill-viewer ()
  (let* ((buffer (generate-new-buffer " *retention-target*"))
         (target (ende-target-create :buffer buffer :start 1 :end 1 :cursor 1
                                     :review-policy 'ignore))
         (hook (lambda () (ert-fail "Disposal invoked the execution cancellation hook")))
         (job (ende--make-job :id 890 :state 'running :target target
                              :owned-buffer buffer :owned-buffer-hook hook))
         (transcript (ende-job-ensure-transcript job))
         (viewer (ende-work-buffer-open job)))
    (unwind-protect
        (progn
          (with-current-buffer buffer (add-hook 'kill-buffer-hook hook nil t))
          (ende--job-release-owned-buffer job)
          (should-not (buffer-live-p buffer))
          (should-not (ende-job-target job))
          (should-not (ende-job-owned-buffer job))
          (should-not (ende-job-owned-buffer-hook job))
          (should-not (marker-buffer (ende-target-cursor-marker target)))
          (should (eq (ende-job-state job) 'running))
          (should (buffer-live-p viewer))
          (should (eq (ende-job-transcript job) transcript))
          (ende--job-release-owned-buffer job)
          (should (buffer-live-p viewer)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (remove-hook 'kill-buffer-hook hook t))
        (kill-buffer buffer))
      (when (buffer-live-p viewer) (kill-buffer viewer)))))

(ert-deftest ende-test/retention-owned-buffer-disposal-preserves-user-target ()
  (with-temp-buffer
    (insert "User-owned source")
    (let* ((target (ende-target-create :buffer (current-buffer) :start 1 :end 1 :cursor 1
                                       :review-policy 'ignore))
           (buffer (generate-new-buffer " *retention-unrelated-owned*"))
           (job (ende--make-job :target target :owned-buffer buffer)))
      (unwind-protect
          (progn
            (ende--job-release-owned-buffer job)
            (should-not (buffer-live-p buffer))
            (should (eq (ende-job-target job) target))
            (should (eq (marker-buffer (ende-target-cursor-marker target)) (current-buffer)))
            (should (equal (buffer-string) "User-owned source")))
        (ende-target-release target)
        (when (buffer-live-p buffer) (kill-buffer buffer))))))

(ert-deftest ende-test/retention-eviction-clears-transcript-with-or-without-viewer ()
  (dolist (open-viewer '(nil t))
    (let* ((ende--retained-jobs (make-hash-table :test #'eql))
           (ende-queue-event-functions nil)
           (buffer (generate-new-buffer " *retention-evicted-target*"))
           (target (ende-target-create :buffer buffer :start 1 :end 1 :cursor 1
                                       :review-policy 'ignore))
           (job (ende--make-job :id 891 :state 'completed :target target :owned-buffer buffer))
           (family (ende--make-job-family :root job :members (list job)))
           (ende--finished-families (list family))
           (transcript (ende-job-ensure-transcript job))
           (viewer (and open-viewer (ende-work-buffer-open job))))
      (unwind-protect
          (progn
            (setf (ende-job-family job) family)
            (puthash (ende-job-id job) job ende--retained-jobs)
            (ende-queue-evict-family family)
            (should-not (buffer-live-p buffer))
            (should-not (buffer-live-p viewer))
            (should-not (marker-buffer (ende-target-cursor-marker target)))
            (should-not (ende-job-target job))
            (should-not (ende-job-owned-buffer job))
            (should-not (ende-job-work-buffer job))
            (should-not (ende-job-transcript job))
            (should-not (gethash transcript ende-work-buffer--viewers))
            (should-not (ende-queue-retained-job-by-id (ende-job-id job)))
            (should-not ende--finished-families))
        (when (buffer-live-p buffer) (kill-buffer buffer))
        (when (buffer-live-p viewer) (kill-buffer viewer))))))

(provide 'ende-retention-test)
