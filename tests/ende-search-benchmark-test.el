;;; ende-search-benchmark-test.el --- Search benchmark checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(add-to-list 'load-path
             (expand-file-name "../benchmark" (file-name-directory
                                              (or load-file-name buffer-file-name))))
(require 'ende-search-benchmark)

(ert-deftest ende-search-benchmark-end-to-end ()
  (let ((ende-search-benchmark-sizes '(4))
        (ende-search-benchmark-samples 2)
        (ende-search-benchmark-instrument t)
        (make-temp (symbol-function 'make-temp-file))
        (run-case (symbol-function 'ende-search-benchmark--case))
        (invoke (symbol-function 'ende-search-benchmark--invoke))
        (start (symbol-function 'ende-worker--start))
        (checkout (symbol-function 'ende-worker--checkout))
        (ready-invocations 0) (ready-checkouts 0)
        current-layer workers roots report)
    (unwind-protect
        (progn
          (ende-worker-prewarm)
          (push ende-worker--standby workers)
          (cl-letf (((symbol-function 'make-temp-file)
                     (lambda (prefix &rest arguments)
                       (let ((path (apply make-temp prefix arguments)))
                         (when (string-prefix-p "ende-search-benchmark-" prefix) (push path roots))
                         path)))
                    ((symbol-function 'ende-search-benchmark--case)
                     (lambda (root configuration manifest workload layer state)
                       (setq current-layer layer)
                       (prog1 (funcall run-case root configuration manifest workload layer state)
                         (should-not ende-worker--standby))))
                    ((symbol-function 'ende-search-benchmark--invoke)
                     (lambda (layer &rest arguments)
                       (if (eq layer 'worker-json-ready)
                           (progn
                             (cl-incf ready-invocations)
                             (should ende-worker--standby)
                             (should (eq (ende-worker--worker-phase ende-worker--standby) 'ready)))
                         (should-not ende-worker--standby))
                       (apply invoke layer arguments)))
                    ((symbol-function 'ende-worker--start)
                     (lambda (worker &optional preload)
                       (push worker workers)
                       (should-not (eq current-layer 'direct))
                       (should (eq (not (null preload)) (eq current-layer 'worker-json-ready)))
                       (funcall start worker preload)))
                    ((symbol-function 'ende-worker--checkout)
                     (lambda ()
                       (let ((worker (funcall checkout)))
                         (should (eq current-layer 'worker-json-ready))
                         (should worker)
                         (should (eq (ende-worker--worker-phase worker) 'ready))
                         (cl-incf ready-checkouts)
                         worker))))
            (with-temp-buffer
              (let ((standard-output (current-buffer)))
                (setq report (ende-search-benchmark-run))
                (should (equal (string-trim (buffer-string)) (json-encode report))))))
          (should-not ende-worker--standby)
          (dolist (worker workers)
            (should (eq (ende-worker--worker-phase worker) 'finished))
            (should-not (process-live-p (ende-worker--worker-process worker)))
            (should-not (buffer-live-p (ende-worker--worker-output worker)))
            (should-not (buffer-live-p (ende-worker--worker-errors worker)))
            (should-not (ende-worker--worker-timer worker)))
          (should (= ready-checkouts ready-invocations))
          (should (= ready-invocations
                     (* 2 (length (ende-search-benchmark--workloads))
                        (1+ (* 2 ende-search-benchmark-samples)))))
          (should (= (length roots) 2))
          (should-not (cl-some #'file-exists-p roots))
          (should (= (length (plist-get report :fixtures)) 2))
          (seq-doseq (fixture (plist-get report :fixtures))
            (let ((cases (plist-get fixture :cases)))
              (should (= (length cases) (* 3 2 (length (ende-search-benchmark--workloads)))))
              (dolist (layer '("direct" "worker-json" "worker-json-ready"))
                (should (member layer (mapcar (lambda (c) (plist-get c :layer)) cases))))
              (seq-doseq (case cases)
                (dolist (field '(:wall :gc_count :gc_seconds :parent_timer_max_lag))
                  (let* ((raw (mapcar (lambda (sample) (plist-get sample field))
                                      (plist-get case :samples)))
                         (summary (plist-get case field)))
                    (should (= (length raw) ende-search-benchmark-samples))
                    (should (= (plist-get summary :median) (/ (apply #'+ raw) 2.0)))
                    (should (= (plist-get summary :p95) (apply #'max raw)))))
                (seq-doseq (sample (plist-get case :samples))
                  (dolist (field '(:wall :gc_count :gc_seconds :parent_timer_max_lag
                                         :result_bytes :files_inspected :matching_lines))
                    (should (numberp (plist-get sample field)))
                    (should (>= (plist-get sample field) 0))))))))
      (ende-worker-shutdown))))

(ert-deftest ende-search-benchmark-validation-fails-closed ()
  (dolist (failure '((validation . "validation failed")
                     (readiness . "readiness failed or timed out")
                     (checkout . "ready worker checkout missed")
                     (instrumentation . "validation failed")))
    (let* ((mode (car failure))
           (ende-search-benchmark-sizes '(1))
           (ende-search-benchmark-samples 1)
           (ende-search-benchmark-instrument (eq mode 'instrumentation))
           (ende-search-benchmark-timeout (if (eq mode 'readiness) 0.02 30))
           (layer (if (memq mode '(readiness checkout)) 'worker-json-ready 'direct))
           (make-temp (symbol-function 'make-temp-file))
           (run-case (symbol-function 'ende-search-benchmark--case))
           (search (symbol-function 'ende-tools--search-project))
           (ready-filter (symbol-function 'ende-worker--ready-filter))
           (checkout (symbol-function 'ende-worker--checkout))
           (instrument (symbol-function 'ende-search-benchmark--instrument))
           (start (symbol-function 'ende-worker--start))
           (counter-functions
            (mapcar (lambda (name) (cons name (symbol-function name)))
                    '(file-truename file-attributes insert-file-contents
                      ende-tools--matching-path-scopes)))
           (started (float-time))
           instrumenting workers roots)
      (unwind-protect
          (progn
            (cl-letf (((symbol-function 'make-temp-file)
                       (lambda (prefix &rest arguments)
                         (let ((path (apply make-temp prefix arguments)))
                           (when (string-prefix-p "ende-search-benchmark-" prefix) (push path roots))
                           path)))
                      ((symbol-function 'ende-search-benchmark--case)
                       (lambda (root configuration manifest workload candidate state)
                         (when (eq candidate layer)
                           (funcall run-case root configuration manifest workload candidate state))))
                      ((symbol-function 'ende-tools--search-project)
                       (lambda (&rest arguments)
                         (if (or (eq mode 'validation) instrumenting)
                             (list :files [] :files_inspected 0 :truncated nil)
                           (apply search arguments))))
                      ((symbol-function 'ende-worker--ready-filter)
                       (lambda (worker process text)
                         (unless (eq mode 'readiness) (funcall ready-filter worker process text))))
                      ((symbol-function 'ende-worker--checkout)
                       (lambda () (unless (eq mode 'checkout) (funcall checkout))))
                      ((symbol-function 'ende-worker--start)
                       (lambda (worker &optional preload)
                         (push worker workers)
                         (should preload)
                         (funcall start worker preload)))
                      ((symbol-function 'ende-search-benchmark--instrument)
                       (lambda (function)
                         (setq instrumenting t)
                         (unwind-protect
                             (progn
                               (ende-worker-prewarm)
                               (funcall instrument function))
                           (setq instrumenting nil)))))
              (with-temp-buffer
                (let ((standard-output (current-buffer)))
                  (should (string-match-p
                           (cdr failure)
                           (error-message-string (should-error (ende-search-benchmark-run)))))
                  (should (string-empty-p (buffer-string))))))
            (when (eq mode 'readiness)
              (should (< (- (float-time) started) ende-worker--startup-timeout)))
            (should-not ende-worker--standby)
            (dolist (worker workers)
              (should (eq (ende-worker--worker-phase worker) 'finished))
              (should-not (process-live-p (ende-worker--worker-process worker)))
              (should-not (buffer-live-p (ende-worker--worker-output worker)))
              (should-not (buffer-live-p (ende-worker--worker-errors worker)))
              (should-not (ende-worker--worker-timer worker)))
            (dolist (entry counter-functions)
              (should (eq (symbol-function (car entry)) (cdr entry))))
            (should roots)
            (should-not (cl-some #'file-exists-p roots)))
        (ende-worker-shutdown)))))

(provide 'ende-search-benchmark-test)
;;; ende-search-benchmark-test.el ends here
