;;; ende-websocket-test.el --- WebSocket behavioral checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(load (expand-file-name "../lisp/ende-websocket"
                        (file-name-directory (or load-file-name buffer-file-name)))
      nil t)

(defmacro ende-websocket-test--connection (binding &rest body)
  (declare (indent 1))
  `(let* ((,binding (ende-websocket--new 'client (ende-websocket--limits nil) nil))
          (process (make-pipe-process :name "websocket-test" :noquery t :coding 'binary)))
     (setf (ende-websocket--connection-state ,binding) 'open
           (ende-websocket--connection-process ,binding) process)
     (set-process-plist process (list 'ende-websocket--connection ,binding 'ende-websocket--generation 0))
     (unwind-protect (progn ,@body)
       (ende-websocket-abort ,binding)
       (ende-websocket--dispatch ,binding))))

(defun ende-websocket-test--drain (connection)
  (when (ende-websocket--connection-work-timer connection)
    (cancel-timer (ende-websocket--connection-work-timer connection))
    (setf (ende-websocket--connection-work-timer connection) nil))
  (ende-websocket--run connection))

(ert-deftest ende-websocket-codec ()
  (should (equal (ende-websocket--accept "dGhlIHNhbXBsZSBub25jZQ==")
                 "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="))
  (let* ((wire (unibyte-string #x81 #x85 #x37 #xfa #x21 #x3d
                               #x7f #x9f #x4d #x51 #x58))
         (header (ende-websocket--frame-header wire 'server 1024))
         (frame (cdr header)))
    (should (= (car header) 6))
    (should (equal (ende-websocket--mask! (substring wire 6)
                                    (ende-websocket--frame-mask frame) 0) "Hello"))
    (should-error (ende-websocket--frame-header wire 'client 1024)
                  :type 'ende-websocket-protocol-error))
  (dolist (bytes (list (unibyte-string #x81 #x7e 0 1)
                       (unibyte-string #x89 #x7e 0 126)
                       (unibyte-string #xc1 0)
                       (unibyte-string #x83 0)))
    (should-error (ende-websocket--frame-header bytes 'client 1024)
                  :type 'ende-websocket-protocol-error))
  (should-error (ende-websocket--text (unibyte-string 255)) :type 'ende-websocket-invalid-utf8)
  (dolist (text '("" "Hello" "ÿ" "\ufeff\r\nλ😀"))
    (let ((bytes (ende-websocket--text text)))
      (dotimes (split (1+ (length bytes)))
        (let ((state (ende-websocket--utf8-create)))
          (ende-websocket--utf8-feed state (substring bytes 0 split))
          (ende-websocket--utf8-feed state (substring bytes split) t)))
      (should (equal text (decode-coding-string bytes 'utf-8-unix)))))
  (dolist (bytes (list '(#xc0 #x80) '(#xed #xa0 #x80) '(#xf4 #x90 #x80 #x80)
                       '(#x80) '(#xe0 #x9f #xbf) '(#xf0 #x8f #xbf #xbf) '(#xc2)))
    (setq bytes (apply #'unibyte-string bytes))
    (dotimes (split (1+ (length bytes)))
      (should-error
       (let ((state (ende-websocket--utf8-create)))
         (ende-websocket--utf8-feed state (substring bytes 0 split))
         (ende-websocket--utf8-feed state (substring bytes split) t))
       :type 'ende-websocket-invalid-utf8))))

(defun ende-websocket-test--http (wire)
  (let ((http (ende-websocket--http-create)))
    (dolist (line (butlast (split-string wire "\r\n")))
      (ende-websocket--http-line http line ende-websocket--default-limits))
    http))

(ert-deftest ende-websocket-opening-boundary ()
  (let ((request (ende-websocket--client-request (ende-websocket--url "ws://example.org/")
                                            "dGhlIHNhbXBsZSBub25jZQ==" nil nil)))
    (dolist (case (list (cons 426 (string-replace "Version: 13" "Version: 12" request))
                       (cons 400 (concat "get" (substring request 3)))))
      (ende-websocket-test--connection connection
        (let (response opened terminal)
          (setf (ende-websocket--connection-role connection) 'server
                (ende-websocket--connection-state connection) 'connecting
                (ende-websocket--connection-callbacks connection)
                (list :on-open (lambda (_) (setq opened t))
                      :on-close (lambda (_ info) (setq terminal info))))
          (cl-letf (((symbol-function 'process-send-string)
                     (lambda (_ bytes) (setq response bytes))))
            (ende-websocket--filter process (concat (cdr case) (unibyte-string #x81 0)))
            (ende-websocket-test--drain connection))
          (should (string-prefix-p (format "HTTP/1.1 %d " (car case)) response))
          (when (= (car case) 426) (should (string-search "Sec-WebSocket-Version: 13\r\n" response)))
          (should-not opened)
          (should (eq (plist-get terminal :cause) 'protocol))))))
  (let* ((key "dGhlIHNhbXBsZSBub25jZQ==")
         (wire (concat "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n"
                       "Sec-WebSocket-Accept: " (ende-websocket--accept key) "\r\n"
                       "X: " (make-string 61 65) "\r\n\r\n" (unibyte-string #x82 1 42))))
    (dotimes (split (1+ (length wire)))
      (ende-websocket-test--connection connection
        (let (messages)
          (setf (ende-websocket--connection-state connection) 'connecting
                (ende-websocket--connection-key connection) key
                (ende-websocket--connection-limits connection) (ende-websocket--limits '(:line-bytes 64))
                (ende-websocket--connection-callbacks connection)
                (list :on-message (lambda (_ _type message) (push message messages))))
          (dolist (chunk (list (substring wire 0 split) (substring wire split)))
            (ende-websocket--filter process chunk)
            (ende-websocket-test--drain connection))
          (should (eq (ende-websocket-state connection) 'open))
          (should (equal messages '("*")))))))
  (let* ((key "dGhlIHNhbXBsZSBub25jZQ==")
         (address (ende-websocket--url "ws://[::1]:8080?x=%20"))
         (request (ende-websocket--client-request address key '("chat") '(("Origin" . "null"))))
         (http (ende-websocket-test--http request)))
    (should (equal (plist-get address :target) "/?x=%20"))
    (should (equal (plist-get (ende-websocket--server-request http) :origin) "null"))
    (should-error (ende-websocket--server-request
                   (ende-websocket-test--http (concat "get" (substring request 3))))
                  :type 'ende-websocket-protocol-error)
    (push '("host" . "other") (ende-websocket--http-fields http))
    (should-error (ende-websocket--server-request http) :type 'ende-websocket-protocol-error)
    (dolist (extra '("" "Sec-WebSocket-Protocol: chat\r\n"))
      (should (member
               (ende-websocket--client-response
                (ende-websocket-test--http
                 (concat "HTTP/1.1 101 Switching Protocols\r\nConnection: keep-alive, Upgrade\r\n"
                         "Upgrade: WebSocket\r\nSec-WebSocket-Accept: " (ende-websocket--accept key)
                         "\r\n" extra "\r\n")) key '("chat")) '(nil "chat"))))
    (dolist (extra '("Sec-WebSocket-Accept: bad\r\n" "Sec-WebSocket-Protocol: other\r\n"
                     "Sec-WebSocket-Extensions: compress\r\n"))
      (should-error
       (ende-websocket--client-response
        (ende-websocket-test--http
         (concat "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n"
                 "Sec-WebSocket-Accept: " (ende-websocket--accept key) "\r\n" extra "\r\n")) key '("chat"))
       :type 'ende-websocket-protocol-error)))
  (dolist (url '("WS://example.org/" "wss://[2001:db8::1]/" "ws://[::ffff:192.0.2.1]:80/"))
    (should (ende-websocket--url url)))
  (dolist (url '("http://host/" "ws://host/#fragment" "ws://user:secret@host/"
                 "ws://host:0/" "ws://host/a b" "ws://host/%2" "ws://host/%gg"
                 "ws://[::::]/" "ws://[1234]/" "ws://a..b/" "ws://999.2.3.4/"))
    (should-error (ende-websocket--url url)))
  (dolist (line '(" Host: example" "Host : example" "Host: x\rInjected: yes"))
    (should-error (ende-websocket-test--http (concat "GET / HTTP/1.1\r\n" line "\r\n\r\n"))
                  :type 'ende-websocket-protocol-error)))

(ert-deftest ende-websocket-message-semantics ()
  (let* ((payload (fillarray (make-string 200000 0) 255))
         (wire (concat (unibyte-string #x82 127 0 0 0 0 0 3 #x0d #x40) payload)))
    (dolist (step '(313 65535 200010))
      (ende-websocket-test--connection connection
        (let ((position 0) received)
          (setf (ende-websocket--connection-callbacks connection)
                (list :on-message (lambda (_ _type message) (setq received message))))
          (while (< position (length wire))
            (let ((end (min (length wire) (+ position step))))
              (ende-websocket--filter process (substring wire position end))
              (setq position end)
              (ende-websocket-test--drain connection)
              (while (ende-websocket--connection-work-timer connection)
                (ende-websocket-test--drain connection))))
          (should (equal received payload))))))
  (let ((wire (unibyte-string 1 1 #xe2 #x89 1 42 #x80 2 #x82 #xac #x82 3 0 255 13 #x88 2 3 #xe8)))
    (dotimes (split (1+ (length wire)))
      (ende-websocket-test--connection connection
        (let (messages writes)
          (setf (ende-websocket--connection-callbacks connection)
                (list :on-message (lambda (_ type message) (push (list type message) messages))))
          (cl-letf (((symbol-function 'process-send-string)
                     (lambda (_ bytes) (push bytes writes))))
            (dolist (chunk (list (substring wire 0 split) (substring wire split)))
              (ende-websocket--filter process chunk)
              (ende-websocket-test--drain connection))
            (while (ende-websocket--connection-work-timer connection)
              (ende-websocket-test--drain connection)))
          (should (equal (nreverse messages) (list '(text "€") (list 'binary (unibyte-string 0 255 13)))))
          (should (= (length writes) 2))))))
  (ende-websocket-test--connection connection
    (ende-websocket--filter process (unibyte-string 1 1 #xe2 #x80 1 #x41))
    (ende-websocket-test--drain connection)
    (should (eq (plist-get (ende-websocket--connection-failure connection) :cause) 'utf8))))

(ert-deftest ende-websocket-lifecycle-and-bounds ()
  (ende-websocket-test--connection connection
    (let (writes)
      (setf (ende-websocket--connection-limits connection)
            (ende-websocket--limits '(:drain-frames 1 :frame-bytes 64 :write-frame-bytes 2)))
      (should (ende-websocket-send-text connection "clear"))
      (should (ende-websocket-send-binary connection ""))
      (ende-websocket-close connection)
      (should (eq (ende-websocket-state connection) 'closing))
      (dolist (send '(ende-websocket-send-text ende-websocket-send-text-bytes ende-websocket-send-binary))
        (should-error (funcall send connection "late")))
      (let ((deadline (assq 'close (ende-websocket--connection-timers connection))))
        (should deadline)
        (cl-letf (((symbol-function 'process-send-string)
                   (lambda (_ bytes)
                     (push bytes writes)
                     (when (= (length writes) 1)
                       (ende-websocket-close connection)
                       (ende-websocket--filter process (unibyte-string #x89 1 42))))))
          (while (ende-websocket--connection-work-timer connection)
            (ende-websocket-test--drain connection)))
        (should (eq deadline (assq 'close (ende-websocket--connection-timers connection)))))
      (should (ende-websocket--connection-close-sent connection))
      (should (= (ende-websocket--connection-output-items connection) 0))
      (should (= (ende-websocket--connection-output-bytes connection) 0))
      (should
       (equal
        (mapcar (lambda (wire)
                  (let* ((header (ende-websocket--frame-header wire 'server 125))
                         (frame (cdr header)))
                    (list (ende-websocket--frame-opcode frame)
                          (ende-websocket--frame-final frame)
                          (ende-websocket--mask! (substring wire (car header))
                                                (ende-websocket--frame-mask frame) 0))))
                (nreverse writes))
        (list '(1 nil "cl") '(10 t "*") '(0 nil "ea") '(0 t "r") '(2 t "")
              (list 8 t (unibyte-string 3 #xe8)))))))
  (ende-websocket-test--connection connection
    (let (reply terminal)
      (setf (ende-websocket--connection-callbacks connection)
            (list :on-close (lambda (_ info) (setq terminal info))))
      (cl-letf (((symbol-function 'process-send-string)
                 (lambda (_ bytes) (setq reply bytes))))
        (ende-websocket--filter process (unibyte-string #x88 2 3 #xf2))
        (ende-websocket-test--drain connection))
      (setf (ende-websocket--connection-eof connection) t)
      (ende-websocket-test--drain connection)
      (ende-websocket-test--drain connection)
      (should (= (plist-get terminal :code) 1010))
      (should (plist-get terminal :clean))
      (let* ((header (ende-websocket--frame-header reply 'server 125))
             (frame (cdr header)))
        (should (= (ende-websocket--frame-opcode frame) 8))
        (should (equal (ende-websocket--mask! (substring reply (car header))
                                        (ende-websocket--frame-mask frame) 0)
                       (unibyte-string 3 #xf2))))))
  (ende-websocket-test--connection connection
    (setf (ende-websocket--connection-role connection) 'server)
    (should-error (ende-websocket-close connection 1010))
    (should (eq (ende-websocket-state connection) 'open)))
  (dolist (wire (list (unibyte-string #x82 126 1 0)
                       (unibyte-string 2 0 0 0 #x80 0)
                       (make-string 65 0)))
    (ende-websocket-test--connection connection
      (setf (ende-websocket--connection-limits connection)
            (ende-websocket--limits '(:frame-bytes 64 :write-frame-bytes 64 :fragment-count 2 :input-bytes 64)))
      (ende-websocket--filter process wire)
      (unless (ende-websocket--connection-failure connection) (ende-websocket-test--drain connection))
      (should (eq (plist-get (ende-websocket--connection-failure connection) :cause) 'size))))
  (dolist (tail (list "" (unibyte-string #x81 5 65)))
    (ende-websocket-test--connection connection
      (let (events)
        (setf (ende-websocket--connection-callbacks connection)
              (list :on-message (lambda (_ type message) (push (list type message) events))
                    :on-close (lambda (_ info) (push (plist-get info :cause) events))))
        (ende-websocket--filter process (concat (unibyte-string #x81 1 65) tail))
        (setf (ende-websocket--connection-eof connection) t)
        (ende-websocket-test--drain connection)
        (ende-websocket-test--drain connection)
        (should (equal (nreverse events) '((text "A") transport))))))
  (ende-websocket-test--connection connection
    (let (messages)
      (setf (ende-websocket--connection-callbacks connection)
            (list :on-message (lambda (_ _type message) (push message messages))))
      (ende-websocket-send-binary connection "out")
      (cl-letf (((symbol-function 'process-send-string)
                 (lambda (_ _bytes) (ende-websocket--filter process (unibyte-string #x82 1 42)))))
        (ende-websocket-test--drain connection))
      (should (timerp (ende-websocket--connection-work-timer connection)))
      (ende-websocket-test--drain connection)
      (should (equal messages '("*")))))
  (ende-websocket-test--connection connection
    (let ((closed 0) info)
      (setf (ende-websocket--connection-callbacks connection)
            (list :on-close (lambda (_ terminal) (cl-incf closed) (setq info terminal))))
      (ende-websocket-abort connection)
      (ende-websocket-abort connection)
      (ende-websocket--filter process (unibyte-string #x81 1 65))
      (ende-websocket-test--drain connection)
      (should (= closed 1))
      (should (eq (plist-get info :cause) 'abort))
      (should-not (ende-websocket--connection-input connection))))
  (dolist (capacity '(1 3))
    (dolist (send '(ende-websocket-send-binary ende-websocket-send-text-bytes ende-websocket-send-text))
      (ende-websocket-test--connection connection
        (setf (ende-websocket--connection-limits connection)
              (ende-websocket--limits (list :output-bytes capacity :output-items 1)))
        (let ((bytes (make-string capacity 97)) (writable 0))
        (setf (ende-websocket--connection-callbacks connection)
              (list :on-writable (lambda (_) (cl-incf writable))))
        (funcall send connection bytes)
        (aset bytes 0 100)
        (should-error (funcall send connection "") :type 'ende-websocket-backpressure)
        (should (equal (ende-websocket--output-bytes (car (ende-websocket--connection-output connection)))
                       (make-string capacity 97)))
        (should (= (ende-websocket--connection-output-items connection) 1))
        (cl-letf (((symbol-function 'process-send-string) #'ignore))
          (ende-websocket-test--drain connection)
          (ende-websocket-test--drain connection))
        (should (= writable 1))))))
  (ende-websocket-test--connection connection
    (setf (ende-websocket--connection-limits connection)
          (ende-websocket--limits '(:drain-frames 2 :frame-bytes 64 :write-frame-bytes 64)))
    (ende-websocket--filter process (unibyte-string #x82 0 #x82 0 #x82 0))
    (ende-websocket-test--drain connection)
    (should (timerp (ende-websocket--connection-work-timer connection)))
    (should (= (with-current-buffer (ende-websocket--connection-input connection)
                 (- (point-max) (ende-websocket--connection-cursor connection))) 2))
    (ende-websocket-test--drain connection)
    (should (= (with-current-buffer (ende-websocket--connection-input connection)
                 (- (point-max) (ende-websocket--connection-cursor connection))) 0))))

(ert-deftest ende-websocket-callbacks-are-serialized ()
  (dolist (action '(receive abort shutdown))
    (ende-websocket-test--connection connection
      (let (events)
        (setf (ende-websocket--connection-callbacks connection)
              (list :on-message
                    (lambda (_ _type text)
                      (push text events)
                      (when (equal text "A")
                        (pcase action
                          ('receive (ende-websocket--filter process (unibyte-string #x81 1 ?C)))
                          ('abort (ende-websocket-abort connection))
                          ('shutdown (ende-websocket-shutdown)))
                        (ende-websocket-test--drain connection)
                        (push 'returned events)))
                    :on-close (lambda (_ _info) (push 'closed events))))
        (ende-websocket--filter process (unibyte-string #x81 1 ?A #x81 1 ?B))
        (ende-websocket-test--drain connection)
        (ende-websocket-test--drain connection)
        (should (equal (nreverse events)
                       (if (eq action 'receive) '("A" returned "B" "C")
                         '("A" returned closed))))))))

(defun ende-websocket-test--wait (predicate)
  (let ((deadline (+ (float-time) 5)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should (funcall predicate))))

(ert-deftest ende-websocket-openings-are-independent-and-bounded ()
  (let (started)
    (unwind-protect
        (cl-letf (((symbol-function 'make-network-process)
                   (lambda (&rest options)
                     (push (plist-get options :host) started)
                     (make-pipe-process :name "websocket-opening-test" :noquery t
                                        :coding 'binary :plist (plist-get options :plist))))
                  ((symbol-function 'process-send-string) #'ignore))
          (let ((first (ende-websocket-connect "ws://first.invalid/" :limits '(:pending-openings 2)))
                (second (ende-websocket-connect "ws://second.invalid/" :limits '(:pending-openings 2))))
            (should-error (ende-websocket-connect "ws://third.invalid/" :limits '(:pending-openings 2))
                          :type 'ende-websocket-backpressure)
            (ende-websocket-test--drain first)
            (ende-websocket-test--drain second)
            (should (= (length started) 2))
            (should (eq (ende-websocket-state first) 'connecting))
            (should (eq (ende-websocket-state second) 'connecting))
            (ende-websocket-abort first)
            (should (ende-websocket-connect "ws://third.invalid/" :limits '(:pending-openings 2)))))
      (ende-websocket-shutdown))))

(ert-deftest ende-websocket-file-output ()
  (dolist (mode '(drain abort invalid replaced))
    (let* ((file (make-temp-file "ende-ws-output-"))
           (payload (if (eq mode 'invalid) (unibyte-string #xe0 #x80 #x80)
                      (encode-coding-string "a€😀z" 'utf-8)))
           (coding-system-for-write 'no-conversion)
           (read-file (symbol-function 'insert-file-contents-literally))
           (released 0) writes reads)
      (unwind-protect
          (ende-websocket-test--connection connection
            (write-region payload nil file nil 'silent)
            (setf (ende-websocket--connection-limits connection)
                  (ende-websocket--limits '(:write-frame-bytes 2 :drain-frames 1 :output-items 1)))
            (cl-letf (((symbol-function 'insert-file-contents-literally)
                       (lambda (&rest _) (ert-fail "Send read its file synchronously"))))
              (should (ende-websocket-send-text-file
                       connection file (lambda () (cl-incf released) (delete-file file))))
              (should-error (ende-websocket-send-text-file connection file)
                            :type 'ende-websocket-backpressure))
            (should (= released 0))
            (when (eq mode 'replaced) (write-region "different" nil file nil 'silent))
            (cl-letf (((symbol-function 'insert-file-contents-literally)
                       (lambda (path visit begin end &rest args)
                         (when (equal path file) (push (- end begin) reads))
                         (apply read-file path visit begin end args)))
                      ((symbol-function 'process-send-string)
                       (lambda (_ wire) (push wire writes))))
              (ende-websocket-test--drain connection)
              (when (eq mode 'abort) (ende-websocket-abort connection))
              (while (ende-websocket--connection-work-timer connection)
                (ende-websocket-test--drain connection)))
            (should (= released 1))
            (should-not (file-exists-p file))
            (should (cl-every (lambda (size) (<= size 2)) reads))
            (when (eq mode 'drain)
              (should (eq (ende-websocket-state connection) 'open))
              (should (equal
                       payload
                       (apply #'concat
                              (mapcar (lambda (wire)
                                        (let ((header (ende-websocket--frame-header wire 'server 2)))
                                          (ende-websocket--mask!
                                           (substring wire (car header))
                                           (ende-websocket--frame-mask (cdr header)) 0)))
                                      (nreverse writes))))))
            (when (eq mode 'invalid)
              (should (eq (plist-get (ende-websocket--connection-failure connection) :cause) 'utf8))))
        (when (file-exists-p file) (delete-file file))))))

(ert-deftest ende-websocket-transport-and-shutdown ()
  (dolist (mode '(reject error))
    (unwind-protect
        (let* ((opened 0) server-info client-info
               (listener
                (ende-websocket-listen
                 :service t
                 :admit (lambda (_ _request) (when (eq mode 'error) (error "Admission failed")))
                 :on-open (lambda (_) (cl-incf opened))
                 :on-close (lambda (_ info) (setq server-info info))))
               (client
                (ende-websocket-connect
                 (format "ws://127.0.0.1:%d" (ende-websocket-listener-port listener))
                 :on-open (lambda (_) (cl-incf opened))
                 :on-close (lambda (_ info) (setq client-info info)))))
          (ende-websocket-test--wait (lambda () (and server-info client-info)))
          (should (= opened 0))
          (should (eq (plist-get server-info :cause) (if (eq mode 'error) 'application 'policy)))
          (should (eq (ende-websocket-state client) 'closed)))
      (ende-websocket-shutdown)))
  (unwind-protect
      (let* (received terminal client-returned server-open listener
             (_listener
              (setq listener (ende-websocket-listen
               :service t
               :admit (lambda (_ request)
                        (should (equal (plist-get request :authority)
                                       (format "127.0.0.1:%d" (ende-websocket-listener-port listener))))
                        (should-not (plist-get request :origin))
                        '(:accept t :protocol "echo"))
               :on-open (lambda (_) (setq server-open t))
               :on-message (lambda (c type message)
                             (if (eq type 'text) (ende-websocket-send-text c message)
                               (ende-websocket-send-binary c message))))))
             (client
              (ende-websocket-connect
               (format "ws://127.0.0.1:%d" (ende-websocket-listener-port listener))
               :protocols '("echo")
               :on-open (lambda (c)
                          (should client-returned)
                          (should (equal (ende-websocket-protocol c) "echo"))
                          (ende-websocket-send-text c "\ufeffλ\r\n😀"))
               :on-message (lambda (c type message)
                             (push (list type message) received)
                             (ende-websocket-close c))
               :on-close (lambda (_ info) (setq terminal info)))))
        (setq client-returned t)
        (ende-websocket-test--wait (lambda () terminal))
        (should server-open)
        (should (equal received '((text "\ufeffλ\r\n😀"))))
        (should (plist-get terminal :clean))
        (should (eq (ende-websocket-state client) 'closed))
        (ende-websocket-stop-listener listener))
    (ende-websocket-shutdown))
  (should (= (hash-table-count ende-websocket--connections) 0))
  (should (= (hash-table-count ende-websocket--listeners) 0))
  (should (= (hash-table-count ende-websocket--openings) 0))
  (ende-websocket-shutdown))

