;;; Commentary:

;; Two Work viewer scenarios: scheduling/lifecycle and deferred rendering.
;; Dashboard reload/retention coverage lives in ende-queue-dashboard-test.el.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'org-colview)
(require 'ende-work-buffer)

(defun ende-test-work--refresh (buffer &optional hidden)
  "Cancel BUFFER's timer and refresh deterministically, displaying unless HIDDEN."
  (with-current-buffer buffer
    (when (timerp ende-work-buffer--refresh-timer)
      (cancel-timer ende-work-buffer--refresh-timer)))
  (if (or hidden (get-buffer-window buffer 'visible)) (ende-work-buffer--refresh buffer)
    (save-window-excursion
      (set-window-buffer (selected-window) buffer)
      (ende-work-buffer--refresh buffer))))

(defun ende-test-work--section (entry)
  "Return canonical ENTRY's section in the current viewer."
  (gethash (ende-transcript-entry-id entry) ende-work-buffer--sections))

(defun ende-test-work--payload (section)
  "Return SECTION's displayed, Org-escaped payload."
  (buffer-substring-no-properties (ende-work-buffer--section-payload-start section)
                                  (ende-work-buffer--section-payload-end section)))

(defun ende-test-work--tab (entry)
  "Cycle ENTRY with the viewer's ordinary TAB command."
  (goto-char (ende-work-buffer--section-start (ende-test-work--section entry)))
  (call-interactively (key-binding (kbd "TAB"))))

(ert-deftest ende-test/work-scheduling-visibility-and-lifecycle ()
  (save-window-excursion
    (delete-other-windows)
    (with-temp-buffer
      (let* ((hidden (current-buffer)) (window (selected-window))
             (job (ende--make-job :id 800 :state 'running :instruction '(:task "Deferred task")))
             (transcript (ende-job-ensure-transcript job))
             (render (symbol-function 'ende-work-buffer--render-pending))
             (schedule (symbol-function 'run-at-time))
             (renders 0) schedules buffer buffers response text summary)
        (set-window-buffer window hidden)
        (unwind-protect
            (cl-letf (((symbol-function 'ende-work-buffer--render-pending)
                       (lambda () (cl-incf renders) (funcall render)))
                      ((symbol-function 'run-at-time)
                       (lambda (delay repeat function &rest arguments)
                         (when (eq function #'ende-work-buffer--refresh)
                           (push (list delay repeat) schedules))
                         (apply schedule delay repeat function arguments))))
              (cl-labels ((drive () (ende-test-work--refresh buffer t))
                          (show ()
                            (set-window-buffer window buffer)
                            (with-current-buffer buffer
                              (should (local-variable-p 'window-buffer-change-functions))
                              (run-hook-with-args 'window-buffer-change-functions window)))
                          (pending (expected)
                            (with-current-buffer buffer
                              (should (equal (reverse ende-work-buffer--pending-order) (mapcar #'car expected)))
                              (should (= (hash-table-count ende-work-buffer--pending) (length expected)))
                              (dolist (item expected)
                                (should (eq (gethash (car item) ende-work-buffer--pending) (cdr item)))))))
                (ende-transcript-begin-response transcript)
                (ende-transcript-event transcript '(:type :delta :channel :content :text "Hidden"))
                (ende-transcript-event transcript '(:type :reasoning-summary :item "plan" :text "Draft"))
                (setq response (ende-transcript-response transcript)
                      text (gethash '(text . :content) (ende-transcript-sources transcript))
                      summary (car (last (ende-transcript-entries transcript)))
                      buffer (ende-work-buffer-open job))
                (push buffer buffers)
                (with-current-buffer buffer
                  (should (equal (buffer-string) (concat "#+COLUMNS: " ende-org-columns-format "\n\n"))))
                (dotimes (_ 8) (ende-transcript-event transcript '(:type :delta :channel :content :text ".")))
                (cl-letf (((symbol-function 'ende-transcript-entry-content)
                           (lambda (_) (ert-fail "Read a hidden payload"))))
                  (drive))
                (should (= renders 0))
                (should-not schedules)
                (pending (list (cons response 'replace) (cons text 'replace) (cons summary 'replace)))
                (show)
                (let ((timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer)))
                  (should (timerp timer))
                  (should (equal (car schedules) '(0.1 nil)))
                  (dotimes (_ 8)
                    (ende-transcript-event transcript '(:type :delta :channel :content :text "."))
                    (should (eq timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer))))
                  (should (= (length schedules) 1))
                  (should (= renders 0)))
                (drive)
                (pending nil)
                ;; Replacement dominates append without changing observation order.
                (ende-transcript-event transcript '(:type :reasoning-summary :item "plan" :text "Rewritten" :replace t))
                (let ((timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer)))
                  (ende-transcript-event transcript '(:type :reasoning-summary :item "plan" :text " plus"))
                  (ende-transcript-event transcript '(:type :delta :channel :content :text " visible"))
                  (ende-transcript-event transcript '(:type :metadata :metadata (:source :response :model "fixture")))
                  (should (eq timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer))))
                (pending (list (cons summary 'replace) (cons text 'append) (cons response 'metadata)))
                ;; A notification arriving inside a render survives its consumed snapshot.
                (let ((entry-function (symbol-function 'ende-work-buffer--entry)) injected)
                  (cl-letf (((symbol-function 'ende-work-buffer--entry)
                             (lambda (entry change)
                               (prog1 (funcall entry-function entry change)
                                 (when (and (eq entry summary) (not injected))
                                   (setq injected t)
                                   (ende-transcript-event transcript
                                                          '(:type :reasoning-summary :item "plan" :text " during refresh")))))))
                    (drive))
                  (should injected))
                (should (= renders 2))
                (pending (list (cons summary 'append)))
                (should (timerp (buffer-local-value 'ende-work-buffer--refresh-timer buffer)))
                (should-not (string-match-p "during refresh" (with-current-buffer buffer (buffer-string))))
                (cl-letf (((symbol-function 'ende-transcript-entry-content)
                           (lambda (_) (ert-fail "Joined a heading or append prefix"))))
                  (drive))
                (pending nil)
                (should (string-match-p "Rewritten plus during refresh" (with-current-buffer buffer (buffer-string))))
                ;; Hidden terminal changes catch up through the ordinary window hook.
                (set-window-buffer window hidden)
                (let ((before (with-current-buffer buffer (buffer-string))))
                  (ende-transcript-accept transcript '(:content "Final answer") nil nil t)
                  (ende-transcript-finish transcript 'completed)
                  (should-not (buffer-local-value 'ende-work-buffer--refresh-timer buffer))
                  (drive)
                  (should (= renders 3))
                  (should (equal before (with-current-buffer buffer (buffer-string)))))
                (show)
                (drive)
                (should (= renders 4))
                (with-current-buffer buffer
                  (should (string-match-p "Final answer" (buffer-string)))
                  (should (string-match-p "Status: completed" (buffer-string))))
                ;; Disposal releases resources; old callbacks cannot affect a new viewer.
                (dolist (dispose '(kill-buffer fundamental-mode))
                  (show)
                  (drive)
                  (ende-transcript-append transcript 'progress "Late" '(:title "Activity"))
                  (let* ((count renders)
                         (timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer))
                         (callback (timer--function timer)) (arguments (timer--args timer))
                         (marker (with-current-buffer buffer
                                   (ende-work-buffer--section-start (ende-test-work--section text)))))
                    (should (memq timer timer-list))
                    (with-current-buffer buffer (funcall dispose))
                    (should-not (ende-job-work-buffer job))
                    (should-not (gethash transcript ende-work-buffer--viewers))
                    (should-not (memq timer timer-list))
                    (should-not (marker-buffer marker))
                    (setq buffer (ende-work-buffer-open job))
                    (push buffer buffers)
                    (apply callback arguments)
                    (should (= count renders))
                    (should (eq buffer (ende-job-work-buffer job)))
                    (should (eq buffer (gethash transcript ende-work-buffer--viewers)))
                    (should (eq (ende-job-state job) 'running))))))
          (dolist (item buffers) (when (buffer-live-p item) (kill-buffer item))))))))

(ert-deftest ende-test/work-rendering-and-deferred-details ()
  ;; Chunk boundaries must not change Org escaping, including after replacement.
  (dolist (chunks (list '("first\n#" "+end_example\n" "* forged\n" " ," ",#" "+begin_src\n")
                        '("\t  " ",," "* heading\n#" "x\n,#" "+directive\n,,plain\n")
                        (list "\n " (make-string 4096 ?λ) "tail" "\n\t," "#" "+end_example")))
    (with-temp-buffer
      (org-mode)
      (let* ((ende-work-buffer--sections (make-hash-table :test #'eql))
             (section (ende-work-buffer--ensure-section 'task nil)) (raw ""))
        (ende-work-buffer--replace-example section raw)
        (dolist (chunk chunks)
          (setq raw (concat raw chunk))
          (ende-work-buffer--append-example section chunk)
          (should (= (ende-work-buffer--section-rendered-length section) (length raw)))
          (should (equal (ende-test-work--payload section) (org-escape-code-in-string raw))))
        (let ((incremental (buffer-string)))
          (ende-work-buffer--replace-example section raw)
          (should (equal incremental (buffer-string))))
        (ende-work-buffer--replace-example section "replacement\n,#")
        (ende-work-buffer--append-example section "+begin_src\nλ")
        (should (equal (ende-test-work--payload section) "replacement\n,,#+begin_src\nλ")))))
  (save-window-excursion
    (delete-other-windows)
    (let* ((profile '(:model "requested-model" :reasoning-effort "high"))
           (job (ende--make-job :id 801 :profile profile :instruction '(:task "#+end_example\n* forged")))
           (transcript (ende-job-ensure-transcript job))
           (object (ende-protocol-json-read-string
                    "{\"multiline\":\"one\\n#+end_example\\n* forged\\n,#+end_example\",\"literal\":\"one\\\\ntwo\"}"))
           (arguments (json-serialize object)) (prefix (substring arguments 0 24))
           (call (list :key 2 :id "call" :name "inspect" :arguments "{"
                       :execution-id "exact" :store-file "/tmp/entry-specific.sqlite"))
           (stored "{\"ok\":false,\"content\":\"one\\ntwo\"}")
           (display (symbol-function 'ende-work-buffer--display-text))
           (json (symbol-function 'ende-work-buffer--readable-json))
           (counts (make-hash-table :test #'eq)) (jsons 0) (loads 0)
           (ende-tool-store-file "/tmp/ambient.sqlite")
           (org-mode-hook (list (lambda () (setq-local ende-test-work-hook-ran t)
                                 (setq-local ende-tool-store--local-file ende-tool-store-file))))
           buffer child-buffer raw-buffer text artifact tool opaque result)
      (unwind-protect
          (cl-letf (((symbol-function 'ende-work-buffer--display-text)
                     (lambda (entry) (cl-incf (gethash entry counts 0)) (funcall display entry)))
                    ((symbol-function 'ende-work-buffer--readable-json)
                     (lambda (raw) (cl-incf jsons) (funcall json raw)))
                    ((symbol-function 'ende-tool-store-load-execution)
                     (lambda (id file)
                       (cl-incf loads)
                       (should (equal (list id file) '("exact" "/tmp/entry-specific.sqlite")))
                       (list :arguments arguments :content stored)))
                    ((symbol-function 'ende-tool-store--filename) (lambda () (ert-fail "Used ambient store")))
                    ((symbol-function 'ende-tool-store-put) (lambda (&rest _) (ert-fail "Wrote storage")))
                    ((symbol-function 'ende-tool-store--new-execution-id) (lambda () (ert-fail "Allocated ID")))
                    ((symbol-function 'ende-tool-store-save-opaque) (lambda (&rest _) (ert-fail "Stored item")))
                    ((symbol-function 'ende-tool-store-load-opaque) (lambda (&rest _) (ert-fail "Loaded retained item")))
                    ((symbol-function 'ende-artifact-prepare-text) (lambda (&rest _) (ert-fail "Prepared artifact")))
                    ((symbol-function 'pop-to-buffer) #'identity))
            (cl-labels ((arguments (value change)
                          (let ((start (ende-transcript-entry-length tool)))
                            (setf (plist-get call :arguments) value)
                            (ende-transcript-event
                             transcript
                             (append (list :type :item :kind 'tool-call :key 2 :call call)
                                     (when (eq change 'append)
                                       (list :append t :arguments-delta (substring value start)))))))
                        (refresh ()
                          (let ((before (prin1-to-string transcript)))
                            (ende-test-work--refresh buffer)
                            (should (equal before (prin1-to-string transcript)))))
                        (raw (entry expected)
                          (let ((before (prin1-to-string transcript)))
                            (should-not (ende-work-buffer--section-materialized (ende-test-work--section entry)))
                            (goto-char (ende-work-buffer--section-start (ende-test-work--section entry)))
                            (setq raw-buffer (call-interactively (key-binding (kbd "r"))))
                            (with-current-buffer raw-buffer
                              (should buffer-read-only)
                              (should (equal (buffer-string) expected))
                              (should (string-match-p "/tmp/entry-specific.sqlite" header-line-format)))
                            (should (equal before (prin1-to-string transcript)))))
                        (all ()
                          (let ((last-command 'org-shifttab) (this-command 'org-shifttab))
                            (dotimes (_ 3)
                              (unless (eq org-cycle-global-status 'all)
                                (call-interactively #'org-shifttab))))
                          (should (eq org-cycle-global-status 'all))
                          (refresh)))
              (ende-transcript-begin-response transcript)
              (ende-transcript-event transcript '(:type :metadata :metadata (:model "reported-model")))
              (ende-transcript-event transcript '(:type :delta :channel :content :text "Read this\n,#"))
              (setq text (gethash '(text . :content) (ende-transcript-sources transcript)))
              (setf (ende-transcript-entry-data text) '(:normalized (:content "Never substitute nonblank raw")))
              (setq artifact (ende-transcript-append transcript 'text " \n"
                                                     '(:normalized (:content "[[file:/tmp/generated.png]]"))))
              (ende-transcript-event transcript (list :type :item :kind 'tool-call :key 2 :call call))
              (setq tool (ende-transcript-tool-call-entry transcript call))
              (ende-transcript-event transcript (list :type :item :kind 'opaque :key 4 :provider "test" :item object))
              (setq opaque (car (last (ende-transcript-entries transcript)))
                    buffer (ende-work-buffer-open job))
              (set-window-buffer (selected-window) buffer)
              (refresh)
              (with-current-buffer buffer
                (should (and (derived-mode-p 'org-mode) ende-work-buffer-mode buffer-read-only))
                (should (bound-and-true-p ende-test-work-hook-ran))
                (should (memq #'org-before-change-function before-change-functions))
                (should (memq #'ende-work-buffer--visibility-changed org-cycle-hook))
                (should (eq (key-binding (kbd "TAB")) #'org-cycle))
                (dolist (entry (list tool opaque))
                  (let ((section (ende-test-work--section entry)))
                    (should (ende-work-buffer--folded-p section))
                    (should-not (ende-work-buffer--section-materialized section))
                    (should (eq (ende-work-buffer--section-stale section) 'replace))
                    (should (equal (ende-test-work--payload section) "Expand to read payload."))))
                (arguments prefix 'append)
                (ende-transcript-notify transcript opaque 'replace)
                (cl-letf (((symbol-function 'ende-transcript-entry-content)
                           (lambda (_) (ert-fail "Read a folded detail payload"))))
                  (refresh))
                (ende-transcript-notify transcript (ende-transcript-response transcript) 'metadata)
                (refresh)
                (should (equal (mapcar (lambda (entry) (gethash entry counts 0)) (list tool opaque)) '(0 0)))
                (should (= jsons loads 0))
                (should (= (gethash text counts) (gethash artifact counts) 1))
                (raw tool prefix)
                (should (eq (ende-work-buffer--raw-payload opaque) object))
                (should (equal (ende-work-buffer--raw-payload artifact) " \n"))
                ;; Expand then collapse before refresh: no payload work or retry timer.
                (ende-test-work--tab tool)
                (should (timerp ende-work-buffer--refresh-timer))
                (ende-test-work--tab tool)
                (refresh)
                (should (ende-work-buffer--folded-p (ende-test-work--section tool)))
                (should (eq (ende-work-buffer--section-stale (ende-test-work--section tool)) 'replace))
                (should-not ende-work-buffer--refresh-timer)
                (should-not ende-work-buffer--pending-order)
                (should (= (gethash tool counts 0) jsons loads 0))
                (ende-test-work--tab tool)
                (refresh)
                (let* ((section (ende-test-work--section tool))
                       (revision (ende-work-buffer--section-revision section)))
                  (should (= (gethash tool counts) 1))
                  (should-not (ende-work-buffer--section-stale section))
                  (should (equal (ende-test-work--payload section) prefix))
                  (arguments arguments 'append)
                  (refresh)
                  (should (= revision (ende-work-buffer--section-revision section)))
                  (should (equal (ende-test-work--payload section) (org-escape-code-in-string arguments)))
                  (should (= (gethash tool counts) 2))
                  (should (= jsons loads 0)))
                ;; A materialized, folded body remembers replacement across appends.
                (let* ((section (ende-test-work--section tool))
                       (revision (ende-work-buffer--section-revision section)))
                  (ende-test-work--tab tool)
                  (arguments " " 'replace)
                  (setq arguments (concat " " arguments))
                  (arguments arguments 'append)
                  (refresh)
                  (should (eq (ende-work-buffer--section-stale section) 'replace))
                  (should (= (gethash tool counts) 2))
                  (should-not ende-work-buffer--refresh-timer)
                  (ende-test-work--tab tool)
                  (refresh)
                  (should (= (ende-work-buffer--section-revision section) (1+ revision)))
                  (should (equal (ende-test-work--payload section) (org-escape-code-in-string arguments)))
                  (should (= (gethash tool counts) 3))
                  (should (= jsons loads 0)))
                ;; Independent windows retain their reader anchor and follow-end choice.
                (let* ((reader (selected-window)) (following (split-window-below))
                       (section (ende-test-work--section text))
                       (anchor (copy-marker (1- (ende-work-buffer--section-payload-end section)) t))
                       (sentinel (make-overlay 3 5)))
                  (set-window-buffer following buffer)
                  (goto-char anchor)
                  (set-window-point reader anchor)
                  (set-window-point following (point-max))
                  (ende-transcript-event transcript '(:type :delta :channel :content :text "+end_example\nMore text"))
                  (refresh)
                  (should (eq section (ende-test-work--section text)))
                  (should (= (overlay-start sentinel) 3))
                  (should (= (point) (window-point reader) anchor))
                  (should (= (window-point following) (point-max)))
                  (ende-test-work--tab text)
                  (ende-transcript-event transcript '(:type :delta :channel :content :text " folded append"))
                  (ende-transcript-append transcript 'progress "Still running" '(:title "Next"))
                  (refresh)
                  (should (ende-work-buffer--folded-p section))
                  (let ((next (ende-test-work--section (car (last (ende-transcript-entries transcript))))))
                    (should-not (invisible-p (ende-work-buffer--section-start next)))
                    (font-lock-ensure (point-min) (point-max))
                    (should (eq (get-text-property (+ 2 (ende-work-buffer--section-start next)) 'face) 'org-level-1)))
                  (delete-overlay sentinel)
                  (set-marker anchor nil))
                ;; Completion replaces raw streaming arguments with readable JSON once.
                (setf (ende-transcript-entry-data tool)
                      (plist-put (ende-transcript-entry-data tool) :duration-ms 0))
                (ende-transcript-event transcript '(:type :usage :usage (:input_tokens 12 :output_tokens 4
                                                                       :input_tokens_details (:cached_tokens 0))))
                (ende-transcript-accept transcript (list :content (ende-transcript-entry-content text) :duration-ms 1200)
                                        (list call) (list :items (list artifact text tool opaque)) t)
                (setq result (ende-transcript-tool-result transcript call nil))
                (ende-transcript-finish transcript 'completed)
                (refresh)
                (should (= (gethash tool counts) 4))
                (should (= jsons 1))
                (should (= loads (gethash result counts 0) (gethash opaque counts 0) 0))
                (should (equal (ende-test-work--payload (ende-test-work--section tool))
                               (org-escape-code-in-string (funcall json arguments))))
                (dolist (folded '(nil t))
                  (when folded (ende-test-work--tab tool))
                  (ende-transcript-notify transcript tool 'metadata)
                  (refresh)
                  (should (eq (and (ende-work-buffer--folded-p (ende-test-work--section tool)) t) folded)))
                (should (= (gethash tool counts) 4))
                (should (= jsons 1))
                (raw result stored)
                (should (= loads 1))
                (should (equal ende-tool-store--local-file "/tmp/ambient.sqlite"))
                (all)
                (should (= (gethash opaque counts) (gethash result counts) 1))
                (should (= jsons 3))
                (should (= loads 2))
                (should (string-match-p (regexp-quote "one\n,#+end_example\n,* forged\n,,#+end_example") (buffer-string)))
                (should (string-match-p (regexp-quote "\"literal\": \"one\\ntwo\"") (buffer-string)))
                (should (string-match-p (regexp-quote "[[file:/tmp/generated.png]]") (buffer-string)))
                (should-not (string-match-p "Never substitute\\|^\\* forged$" (buffer-string)))
                (let (seen)
                  (org-map-entries
                   (lambda ()
                     (let ((entry (get-text-property (point) 'ende-work-buffer-entry)))
                       (push entry seen)
                       (should (= (org-current-level) 1))
                       (should (equal (org-entry-get nil "ENDE_DURATION_MS")
                                      (pcase (ende-transcript-entry-kind entry) ('response "1200") ('tool-result "0")))))
                     (dolist (property '(("ENDE_MODEL" . "reported-model") ("ENDE_REASONING_EFFORT" . "high")
                                         ("ENDE_INPUT_TOKENS" . "12") ("ENDE_OUTPUT_TOKENS" . "4") ("ENDE_CACHED_TOKENS" . "0")))
                       (should (equal (org-entry-get nil (car property)) (cdr property))))))
                  (should (equal (nreverse seen) (ende-transcript-entries transcript))))
                (goto-char (point-min))
                (org-columns)
                (should (equal (mapcar #'car org-columns-current-fmt-compiled)
                               '("ITEM" "ENDE_MODEL" "ENDE_REASONING_EFFORT" "ENDE_INPUT_TOKENS"
                                 "ENDE_CACHED_TOKENS" "ENDE_OUTPUT_TOKENS" "ENDE_DURATION_MS")))
                (org-columns-quit)
                (should (= 1 (how-many "^\\* Agent: Final reply$" (point-min) (point-max))))
                (should (= 1 (how-many "^\\* --> inspect:" (point-min) (point-max))))
                ;; Main recreation and a lazy child reconstruct the same canonical view.
                (let* ((rendered (buffer-string)) (before (prin1-to-string transcript))
                       (child (ende--make-job :id 802 :parent job :profile profile
                                              :transcript (copy-ende-transcript transcript))))
                  (should-not (ende-job-work-buffer child))
                  (kill-buffer buffer)
                  (dolist (owner (list child job))
                    (setq buffer (ende-work-buffer-open owner))
                    (when (eq owner child) (setq child-buffer buffer))
                    (with-current-buffer buffer (refresh) (all) (should (equal rendered (buffer-string)))))
                  (should (equal before (prin1-to-string transcript)))))))
        (dolist (item (list buffer child-buffer raw-buffer))
          (when (buffer-live-p item) (kill-buffer item)))))))

(provide 'ende-work-buffer-test)
;;; ende-work-buffer-test.el ends here
