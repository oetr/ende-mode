;;; Commentary:

;; Two Work viewer scenarios: scheduling/lifecycle and compact cached history.
;; Dashboard reload/retention coverage lives in ende-queue-dashboard-test.el.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'org-colview)
(require 'ende-work-buffer)

(defun ende-test-work--refresh (buffer &optional hidden)
  "Cancel BUFFER's timer and refresh deterministically, displaying unless HIDDEN."
  (with-current-buffer buffer
    (when (timerp ende-work-buffer--refresh-timer)
      (cancel-timer ende-work-buffer--refresh-timer)))
  (if (or hidden (get-buffer-window buffer 'visible)) (ende-work-buffer--refresh buffer)
    (save-window-excursion
      (set-window-buffer (selected-window) buffer)
      (ende-work-buffer--refresh buffer))))

(defun ende-test-work--section (entry)
  "Return canonical ENTRY's section in the current viewer."
  (gethash (ende-transcript-entry-id entry) ende-work-buffer--sections))

(defun ende-test-work--payload (section)
  "Return SECTION's displayed, Org-escaped payload."
  (buffer-substring-no-properties (ende-work-buffer--section-payload-start section)
                                  (ende-work-buffer--section-payload-end section)))

(defun ende-test-work--tab (entry)
  "Cycle ENTRY with the viewer's ordinary TAB command."
  (goto-char (ende-work-buffer--section-start (ende-test-work--section entry)))
  (call-interactively (key-binding (kbd "TAB"))))

(ert-deftest ende-test/work-scheduling-visibility-and-lifecycle ()
  (save-window-excursion
    (delete-other-windows)
    (with-temp-buffer
      (let* ((hidden (current-buffer)) (window (selected-window))
             (job (ende--make-job :id 800 :state 'running :instruction '(:task "Deferred task")))
             (transcript (ende-job-ensure-transcript job))
             (render (symbol-function 'ende-work-buffer--render-pending))
             (schedule (symbol-function 'run-at-time))
             (renders 0) schedules buffer buffers response text summary)
        (set-window-buffer window hidden)
        (unwind-protect
            (cl-letf (((symbol-function 'ende-work-buffer--render-pending)
                       (lambda () (cl-incf renders) (funcall render)))
                      ((symbol-function 'run-at-time)
                       (lambda (delay repeat function &rest arguments)
                         (when (eq function #'ende-work-buffer--refresh)
                           (push (list delay repeat) schedules))
                         (apply schedule delay repeat function arguments))))
              (cl-labels ((drive () (ende-test-work--refresh buffer t))
                          (show ()
                            (set-window-buffer window buffer)
                            (with-current-buffer buffer
                              (should (local-variable-p 'window-buffer-change-functions))
                              (run-hook-with-args 'window-buffer-change-functions window)))
                          (pending (expected)
                            (with-current-buffer buffer
                              (should (equal (reverse ende-work-buffer--pending-order) (mapcar #'car expected)))
                              (should (= (hash-table-count ende-work-buffer--pending) (length expected)))
                              (dolist (item expected)
                                (should (eq (gethash (car item) ende-work-buffer--pending) (cdr item)))))))
                (ende-transcript-begin-response transcript)
                (ende-transcript-event transcript '(:type :delta :channel :content :text "Hidden"))
                (ende-transcript-event transcript '(:type :reasoning-summary :item "plan" :text "Draft"))
                (setq response (ende-transcript-response transcript)
                      text (gethash '(text . :content) (ende-transcript-sources transcript))
                      summary (car (last (ende-transcript-entries transcript)))
                      buffer (ende-work-buffer-open job))
                (push buffer buffers)
                (with-current-buffer buffer
                  (should (equal (buffer-string) (concat "#+COLUMNS: " ende-org-columns-format "\n\n"))))
                (dotimes (_ 8) (ende-transcript-event transcript '(:type :delta :channel :content :text ".")))
                (cl-letf (((symbol-function 'ende-transcript-entry-content)
                           (lambda (_) (ert-fail "Read a hidden payload"))))
                  (drive))
                (should (= renders 0))
                (should-not schedules)
                (pending (list (cons response 'replace) (cons text 'replace) (cons summary 'replace)))
                (show)
                (let ((timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer)))
                  (should (timerp timer))
                  (should (equal (car schedules) '(0.1 nil)))
                  (dotimes (_ 8)
                    (ende-transcript-event transcript '(:type :delta :channel :content :text "."))
                    (should (eq timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer))))
                  (should (= (length schedules) 1))
                  (should (= renders 0)))
                (drive)
                (pending nil)
                ;; Replacement dominates append without changing observation order.
                (ende-transcript-event transcript '(:type :reasoning-summary :item "plan" :text "Rewritten" :replace t))
                (let ((timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer)))
                  (ende-transcript-event transcript '(:type :reasoning-summary :item "plan" :text " plus"))
                  (ende-transcript-event transcript '(:type :delta :channel :content :text " visible"))
                  (ende-transcript-event transcript '(:type :metadata :metadata (:source :response :model "fixture")))
                  (should (eq timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer))))
                (pending (list (cons summary 'replace) (cons text 'append) (cons response 'metadata)))
                ;; A notification arriving inside a render survives its consumed snapshot.
                (let ((entry-function (symbol-function 'ende-work-buffer--entry)) injected)
                  (cl-letf (((symbol-function 'ende-work-buffer--entry)
                             (lambda (entry change)
                               (prog1 (funcall entry-function entry change)
                                 (when (and (eq entry summary) (not injected))
                                   (setq injected t)
                                   (ende-transcript-event transcript
                                                          '(:type :reasoning-summary :item "plan" :text " during refresh")))))))
                    (drive))
                  (should injected))
                (should (= renders 2))
                (pending (list (cons summary 'append)))
                (should (timerp (buffer-local-value 'ende-work-buffer--refresh-timer buffer)))
                (should-not (string-match-p "during refresh" (with-current-buffer buffer (buffer-string))))
                (drive)
                (pending nil)
                (should-not (string-match-p "Rewritten plus during refresh" (with-current-buffer buffer (buffer-string))))
                ;; Hidden terminal changes catch up through the ordinary window hook.
                (set-window-buffer window hidden)
                (let ((before (with-current-buffer buffer (buffer-string))))
                  (ende-transcript-accept transcript '(:content "Final answer") nil nil t)
                  (ende-transcript-finish transcript 'completed)
                  (should-not (buffer-local-value 'ende-work-buffer--refresh-timer buffer))
                  (drive)
                  (should (= renders 3))
                  (should (equal before (with-current-buffer buffer (buffer-string)))))
                (show)
                (drive)
                (should (= renders 4))
                (with-current-buffer buffer
                  (should (string-match-p "Final answer" (buffer-string)))
                  (should (string-match-p "Status: completed" (buffer-string))))
                ;; Disposal releases resources; old callbacks cannot affect a new viewer.
                (dolist (dispose '(kill-buffer fundamental-mode))
                  (show)
                  (drive)
                  (ende-transcript-append transcript 'progress "Late" '(:title "Activity"))
                  (let* ((count renders)
                         (timer (buffer-local-value 'ende-work-buffer--refresh-timer buffer))
                         (callback (timer--function timer)) (arguments (timer--args timer))
                         (marker (with-current-buffer buffer
                                   (ende-work-buffer--section-start (ende-test-work--section text)))))
                    (should (memq timer timer-list))
                    (with-current-buffer buffer (funcall dispose))
                    (should-not (ende-job-work-buffer job))
                    (should-not (gethash transcript ende-work-buffer--viewers))
                    (should-not (memq timer timer-list))
                    (should-not (marker-buffer marker))
                    (setq buffer (ende-work-buffer-open job))
                    (push buffer buffers)
                    (apply callback arguments)
                    (should (= count renders))
                    (should (eq buffer (ende-job-work-buffer job)))
                    (should (eq buffer (gethash transcript ende-work-buffer--viewers)))
                    (should (eq (ende-job-state job) 'running))))))
          (dolist (item buffers) (when (buffer-live-p item) (kill-buffer item))))))))

(ert-deftest ende-test/work-cached-history-and-inert-payloads ()
  ;; Chunk boundaries must not change Org escaping, including after replacement.
  (dolist (chunks (list '("first\n#" "+end_example\n" "* forged\n" " ," ",#" "+begin_src\n")
                        '("\t  " ",," "* heading\n#" "x\n,#" "+directive\n,,plain\n")
                        (list "\n " (make-string 4096 ?λ) "tail" "\n\t," "#" "+end_example")))
    (with-temp-buffer
      (org-mode)
      (let* ((ende-work-buffer--sections (make-hash-table :test #'eql))
             (section (ende-work-buffer--ensure-section 'task nil)) (raw ""))
        (ende-work-buffer--replace-example section raw)
        (dolist (chunk chunks)
          (setq raw (concat raw chunk))
          (ende-work-buffer--append-example section chunk)
          (should (= (ende-work-buffer--section-rendered-length section) (length raw)))
          (should (equal (ende-test-work--payload section) (org-escape-code-in-string raw))))
        (let ((incremental (buffer-string)))
          (ende-work-buffer--replace-example section raw)
          (should (equal incremental (buffer-string))))
        (ende-work-buffer--replace-example section "replacement\n,#")
        (ende-work-buffer--append-example section "+begin_src\nλ")
        (should (equal (ende-test-work--payload section) "replacement\n,,#+begin_src\nλ")))))
  (save-window-excursion
    (delete-other-windows)
    (let* ((job (ende--make-job :id 801 :instruction '(:task "Inspect history")))
           (transcript (ende-job-ensure-transcript job))
           (call '(:name "run_host_command"
                   :arguments "{\"command\":{\"program\":\"check\",\"args\":[]},\"cwd\":\"/project\"}"))
           (reply "{\"title\":\"Outcome\",\"text\":\"Original reply\"}")
           (failure "{\"ok\":true,\"result\":{\"process_ok\":false,\"exit_code\":9,\"stderr\":\"failed\"}}")
           (untrusted "#+end_example\n* forged\n,#+begin_src emacs-lisp\n(message \"inert\")")
           (tool (ende-transcript-append transcript 'tool-call nil (list :call call) 'streaming))
           (text (ende-transcript-append transcript 'text reply nil 'streaming))
           (thinking (ende-transcript-append transcript 'thinking "Reasoning" nil 'streaming))
           (summary (ende-transcript-append transcript 'summary "Plan" nil 'streaming))
           (opaque (ende-transcript-append transcript 'opaque nil '(:item ["retained"]) 'complete))
           (request-render (symbol-function 'ende-render-tool-request))
           (response-render (symbol-function 'ende-render-tool-response))
           (reply-render (symbol-function 'ende-render-reply))
           (renders 0) buffer child-buffer raw-buffer result generic)
      (unwind-protect
          (cl-letf (((symbol-function 'ende-render-tool-request)
                     (lambda (&rest args) (cl-incf renders) (apply request-render args)))
                    ((symbol-function 'ende-render-tool-response)
                     (lambda (&rest args) (cl-incf renders) (apply response-render args)))
                    ((symbol-function 'ende-render-reply)
                     (lambda (&rest args) (cl-incf renders) (apply reply-render args)))
                    ((symbol-function 'ende-tool-store-load-execution)
                     (lambda (&rest _) (ert-fail "Loaded retained execution")))
                    ((symbol-function 'ende-tool-store-load-opaque)
                     (lambda (&rest _) (ert-fail "Loaded retained item")))
                    ((symbol-function 'ende-tool-store-put)
                     (lambda (&rest _) (ert-fail "Wrote storage")))
                    ((symbol-function 'pop-to-buffer) #'identity))
            (cl-labels ((refresh ()
                          (let ((before (prin1-to-string transcript)))
                            (ende-test-work--refresh buffer)
                            (should (equal before (prin1-to-string transcript)))))
                        (raw (entry expected)
                          (goto-char (ende-work-buffer--section-start (ende-test-work--section entry)))
                          (setq raw-buffer (call-interactively (key-binding (kbd "r"))))
                          (with-current-buffer raw-buffer
                            (should buffer-read-only)
                            (should (equal (buffer-string) expected)))))
              (setq buffer (ende-work-buffer-open job))
              (set-window-buffer (selected-window) buffer)
              (refresh)
              (with-current-buffer buffer
                (should (and (derived-mode-p 'org-mode) ende-work-buffer-mode buffer-read-only))
                (should (eq (key-binding (kbd "TAB")) #'org-cycle))
                (dolist (entry (list tool text thinking summary))
                  (should (equal (ende-test-work--payload (ende-test-work--section entry)) "")))
                (should (= renders 0))
                (should-not (ende-work-buffer--section-materialized (ende-test-work--section opaque)))
                ;; Completion metadata changes empty placeholders into formatted history.
                (dolist (entry (list tool text thinking summary))
                  (setf (ende-transcript-entry-status entry) 'complete)
                  (ende-transcript-notify transcript entry 'metadata))
                (setq result (ende-transcript-tool-result transcript call failure)
                      generic (ende-transcript-append transcript 'tool-result untrusted
                                                      '(:call (:name "future_tool")) 'returned))
                (refresh)
                (should (= renders 4))
                (dolist (entry (list tool result generic))
                  (let ((section (ende-test-work--section entry)))
                    (should (ende-work-buffer--folded-p section))
                    (should (ende-work-buffer--section-materialized section))))
                (should (string-search "check" (ende-work-buffer--section-heading (ende-test-work--section tool))))
                (should (string-search "exit 9" (ende-work-buffer--section-heading (ende-test-work--section result))))
                (should (eq (ende-transcript-entry-status result) 'succeeded))
                (should (eq (plist-get (ende-work-buffer--section-presentation
                                       (ende-test-work--section result)) :state) 'error))
                (should-not (ende-work-buffer--folded-p (ende-test-work--section text)))
                (should (equal (ende-test-work--payload (ende-test-work--section text)) "Outcome\n\nOriginal reply"))
                (should (equal (ende-transcript-entry-content text) reply))
                (raw text reply)
                (raw tool (plist-get call :arguments))
                (raw result failure)
                (should (equal (ende-test-work--payload (ende-test-work--section generic))
                               (org-escape-code-in-string untrusted)))
                (let (seen)
                  (org-map-entries
                   (lambda () (push (get-text-property (point) 'ende-work-buffer-entry) seen)))
                  (should (equal (nreverse seen) (ende-transcript-entries transcript))))
                ;; Only opaque details remain lazy; metadata and folding reuse cached tools.
                (ende-test-work--tab tool)
                (ende-test-work--tab opaque)
                (refresh)
                (should (ende-work-buffer--section-materialized (ende-test-work--section opaque)))
                (dolist (entry (list tool result text)) (ende-transcript-notify transcript entry 'metadata))
                (refresh)
                (should (= renders 4))
                (should-not (ende-work-buffer--folded-p (ende-test-work--section tool)))
                (should (ende-work-buffer--folded-p (ende-test-work--section result)))
                ;; Replacement retains identity, reader offsets, and follow-end windows.
                (let* ((reader (selected-window)) (following (split-window-below))
                       (section (ende-test-work--section text))
                       (anchor (+ 3 (ende-work-buffer--section-payload-start section)))
                       (offset (- anchor (ende-work-buffer--section-body-start section))))
                  (set-window-buffer following buffer)
                  (goto-char anchor)
                  (set-window-point reader anchor)
                  (set-window-point following (point-max))
                  (setf (ende-transcript-entry-content text) "{\"title\":\"Outcome\",\"text\":\"Replacement reply, longer\"}")
                  (ende-transcript-notify transcript text 'replace)
                  (refresh)
                  (should (= renders 5))
                  (should (eq section (ende-test-work--section text)))
                  (should (string-search "Replacement reply" (ende-test-work--payload section)))
                  (should (= (point) (window-point reader)
                             (+ offset (ende-work-buffer--section-body-start section))))
                  (should (= (window-point following) (point-max)))
                  (should (ende-work-buffer--folded-p (ende-test-work--section result)))
                  (delete-window following)))
              ;; Cache survives disposal; equivalent child transcripts need no storage.
              (let ((cache (buffer-local-value 'ende-work-buffer--render-cache buffer)))
                (kill-buffer buffer)
                (ende-transcript-append transcript 'text "Arrived while closed" nil 'complete)
                (setq buffer (ende-work-buffer-open job))
                (set-window-buffer (selected-window) buffer)
                (refresh)
                (with-current-buffer buffer
                  (should (eq cache ende-work-buffer--render-cache))
                  (should (= renders 5))
                  (should-not (string-search "Arrived while closed" (buffer-string)))
                  (refresh)
                  (should (string-search "Arrived while closed" (buffer-string)))
                  (should (= renders 6))
                  (let ((ende-render-generation (make-symbol "reloaded")))
                    (dolist (entry (list tool result generic text))
                      (ende-transcript-notify transcript entry 'metadata))
                    (refresh)
                    (should (= renders 10))))
                (let ((rendered (with-current-buffer buffer (buffer-string)))
                      (child (ende--make-job :id 802 :parent job :transcript (copy-ende-transcript transcript))))
                  (should-not (ende-job-work-buffer child))
                  (setq child-buffer (ende-work-buffer-open child))
                  (ende-test-work--refresh child-buffer)
                  (should (equal rendered (with-current-buffer child-buffer (buffer-string))))))
              ;; Cached faces and hidden escape/boundary bytes survive refontification.
              (with-current-buffer buffer
                (font-lock-flush)
                (font-lock-ensure)
                (let* ((position (+ 2 (ende-work-buffer--section-start (ende-test-work--section result))))
                       (face (get-text-property position 'face)))
                  (should (eq (get-text-property position 'ende-render-face) 'ende-render-error-face))
                  (should (memq 'ende-render-error-face (if (listp face) face (list face)))))
                (ende-test-work--tab generic)
                (let* ((section (ende-test-work--section generic))
                       (inside (+ 4 (ende-work-buffer--section-payload-start section))))
                  (font-lock-flush inside (1+ inside))
                  (font-lock-ensure inside (1+ inside))
                  (goto-char (ende-work-buffer--section-payload-start section))
                  (search-forward ",,#+begin_src")
                  (should-not (invisible-p (+ (match-beginning 0) 1)))
                  (dolist (position (list (ende-work-buffer--section-payload-start section)
                                         (ende-work-buffer--section-body-start section)))
                    (should (get-text-property position 'ende-work-buffer-hidden))
                    (should (eq (get-text-property position 'invisible) 'ende-work-buffer-hidden)))))))
        (dolist (item (list buffer child-buffer raw-buffer))
          (when (buffer-live-p item) (kill-buffer item)))))))

(ert-deftest ende-test/work-live-pane-is-independent-and-disposable ()
  (save-window-excursion
    (delete-other-windows)
    (let* ((job (ende--make-job :id 803 :instruction '(:task "Observe stream")))
           (transcript (ende-job-ensure-transcript job))
           (buffer (ende-work-buffer-open job)) live text)
      (unwind-protect
          (progn
            (set-window-buffer (selected-window) buffer)
            (ende-transcript-begin-response transcript)
            (ende-transcript-event transcript '(:type :delta :channel :content :text "first\n* plain"))
            (setq text (gethash '(text . :content) (ende-transcript-sources transcript)))
            (ende-transcript-event transcript '(:type :reasoning-summary :item "plan" :text "Live reasoning"))
            (ende-test-work--refresh buffer)
            (with-current-buffer buffer
              (call-interactively (key-binding (kbd "s")))
              (setq live ende-work-buffer--stream-buffer)
              (should (buffer-live-p live))
              (goto-char (point-min))
              (set-window-point (get-buffer-window buffer) (point))
              (with-current-buffer live
                (should (derived-mode-p 'ende-work-stream-mode))
                (should buffer-read-only)
                (should (string-search "first\n* plain" (buffer-string)))
                (should (string-search "Live reasoning" (buffer-string)))
                (should (< (window-start (get-buffer-window live)) (point-max)))
                (goto-char (point-max))
                (set-window-point (get-buffer-window live) (point)))
              (let ((before (buffer-string))
                    (section (ende-test-work--section text))
                    (append-function (symbol-function 'ende-transcript-entry-substring)))
                (cl-letf (((symbol-function 'ende-transcript-entry-content)
                           (lambda (_) (ert-fail "Joined an unchanged streaming prefix")))
                          ((symbol-function 'ende-transcript-entry-substring)
                           (lambda (entry start &optional end)
                             (when (eq entry text) (should (> start 0)))
                             (funcall append-function entry start end))))
                  (ende-transcript-event transcript '(:type :delta :channel :content :text " appended"))
                  (ende-transcript-event transcript '(:type :reasoning-summary :item "plan" :text " grows"))
                  (ende-test-work--refresh buffer))
                (should (equal before (buffer-string)))
                (should (eq section (ende-test-work--section text)))
                (should (= (point) (point-min)))
                (with-current-buffer live
                  (should (string-search "* plain appended" (buffer-string)))
                  (should (string-search "Live reasoning grows" (buffer-string)))
                  (should (< (window-start (get-buffer-window live)) (point-max)))
                  (should (= (window-point (get-buffer-window live)) (point-max)))))
              (ende-transcript-accept transcript '(:content "first\n* plain appended") nil nil t)
              (ende-test-work--refresh buffer)
              (should (string-search "plain appended" (ende-test-work--payload (ende-test-work--section text))))
              (should (string-search "Live reasoning grows" (buffer-string)))
              (ende-transcript-tool-result transcript '(:name "example") "tool output")
              (ende-test-work--refresh buffer)
              (with-current-buffer live
                (should (string-search "plain appended" (buffer-string)))
                (should (string-search "tool output" (buffer-string))))
              (call-interactively (key-binding (kbd "s")))
              (should-not (get-buffer-window live))
              (kill-buffer live)
              (should-not ende-work-buffer--stream-buffer)
              (call-interactively (key-binding (kbd "s")))
              (setq live ende-work-buffer--stream-buffer)
              (with-current-buffer live
                (should (string-search "plain appended" (buffer-string)))
                (should (string-search "tool output" (buffer-string))))
              (ende-transcript-begin-response transcript)
              (ende-transcript-event transcript '(:type :metadata :metadata (:model "model")))
              (ende-test-work--refresh buffer)
              (with-current-buffer live
                (should (string-search "plain appended" (buffer-string))))
              ;; A whole response can finish between two display refreshes.
              (ende-transcript-event transcript '(:type :delta :channel :content :text "next reply"))
              (ende-transcript-accept transcript '(:content "next reply") nil nil t)
              (ende-test-work--refresh buffer)
              (with-current-buffer live
                (should (string-search "next reply" (buffer-string)))
                (should (< (window-start (get-buffer-window live)) (point-max)))
                (should-not (string-search "plain appended" (buffer-string)))
                (should-not (string-search "tool output" (buffer-string)))))
            (kill-buffer buffer)
            (should-not (buffer-live-p live))
            (should (equal (ende-transcript-entry-content text) "first\n* plain appended")))
        (when (buffer-live-p buffer) (kill-buffer buffer))
        (when (buffer-live-p live) (kill-buffer live))))))

(provide 'ende-work-buffer-test)
;;; ende-work-buffer-test.el ends here
