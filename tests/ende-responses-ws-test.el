(defmacro ende-responses-ws-test--with-sockets (&rest body)
  "Run BODY through the real connector, controlling native process completion."
  (declare (indent 0) (debug t))
  `(let ((ende-responses-ws--connections (make-hash-table :test #'equal))
         (ende-provider-discovery-enabled nil)
         (ende-debugging-enabled nil)
         (websocket-debug t) (websocket-callback-debug-on-error t)
         (sockets nil) (opening nil) (writing nil) (token "fixture-api-key")
         (native-status (symbol-function 'process-status))
         (native-send (symbol-function 'process-send-string)))
     (cl-letf (((symbol-function 'ende-credentials-secret) (lambda (_profile) token))
               ((symbol-function 'ende-codex--resolve-auth)
                (lambda (callback profile)
                  (funcall callback
                           (list :auth-method (plist-get profile :auth-method)
                                 :account (plist-get profile :account)
                                 :registration-id "fixture-registration"
                                 :access-token token :client-id ende-codex-native-client-id
                                 :chatgpt-account-id "fixture-account"
                                 :scope "offline_access chatgpt.tokens.use.direct"))
                  nil))
               ((symbol-function 'ende-curl-start-request)
                (lambda (&rest _) (ert-fail "Selected WebSocket fell back to HTTP")))
               ((symbol-function 'make-network-process)
                (lambda (&rest options)
                  (should-not websocket-debug)
                  (should-not websocket-callback-debug-on-error)
                  (should (plist-get options :nowait))
                  (should (eq (car (plist-get options :tls-parameters)) 'gnutls-x509pki))
                  (should (plist-get (cdr (plist-get options :tls-parameters)) :verify-error))
                  (should-not (file-remote-p default-directory))
                  (should-not url-cookie-storage)
                  (should-not url-cookie-secure-storage)
                  (let ((process (make-pipe-process :name "ende-ws-fixture" :noquery t
                                                    :coding 'binary
                                                    :filter (plist-get options :filter)
                                                    :sentinel (plist-get options :sentinel))))
                    (process-put process :fixture-status 'connect)
                    (push process sockets)
                    (when opening (funcall opening process))
                    process)))
               ((symbol-function 'process-status)
                (lambda (process)
                  (or (and (processp process) (process-get process :fixture-status))
                      (funcall native-status process))))
               ((symbol-function 'process-send-string)
                (lambda (process text)
                  (if (not (process-get process :fixture-status))
                      (funcall native-send process text)
                    (should-not websocket-debug)
                    (should-not websocket-callback-debug-on-error)
                    (should (eq (process-status process) 'open))
                    (if (string-prefix-p "GET " text)
                        (progn
                          (should-not (process-get process :fixture-upgrade))
                          (should (websocket-verify-client-headers text))
                          (process-put process :fixture-upgrade text)
                          (process-put process :fixture-socket (process-get process :websocket)))
                      (let ((frame (websocket-read-frame text)))
                        (when (eq (websocket-frame-opcode frame) 'text)
                          (push (ende-protocol-json-read-string (websocket-frame-text frame))
                                (process-get process :fixture-sent)))
                        (when writing (funcall writing process))))))))
       (unwind-protect (progn ,@body)
         (ende-responses-ws-close-all)
         (dolist (process sockets)
           (set-process-sentinel process #'ignore)
           (delete-process process))))))

(defun ende-responses-ws-test--socket-open (process)
  "Return whether PROCESS still owns an accepted socket."
  (when-let* ((socket (process-get process :websocket)))
    (eq (websocket-ready-state socket) 'open)))

(defun ende-responses-ws-test--socket-sent (process)
  "Return decoded requests actually framed and written to PROCESS."
  (process-get process :fixture-sent))

(defun ende-responses-ws-test--socket-options (process)
  "Return callback and header fixtures for PROCESS."
  (let* ((socket (or (process-get process :websocket) (process-get process :fixture-socket)))
         (text (process-get process :fixture-upgrade)))
    (list :on-message (lambda (_process frame) (funcall (websocket-on-message socket) socket frame))
          :on-close (lambda (_process)
                      (process-put process :fixture-status 'closed)
                      (funcall (process-sentinel process) process "EOF"))
          :custom-header-alist
          (cl-loop for line in (split-string (or text "") "\r\n")
                   when (string-match "\\`\\([^:]+\\): *\\(.*\\)\\'" line)
                   collect (cons (match-string 1 line) (match-string 2 line))))))

(defun ende-responses-ws-test--profile (&optional owner phase method)
  "Resolve a fixture connection for OWNER, PHASE and optional OAuth METHOD."
  (let* ((ende-providers nil) (ende-builtin-provider-settings nil) (ende-custom-providers nil)
         (profile (ende-provider-config-resolve
                   (if method 'openai-codex 'openai) "test-model" nil
                   (when method (list :auth-method method :account 'personal)))))
    (ende-plist-merge profile
                      (append (list :transport 'websocket :job-id owner :request-phase (or phase 'work))
                              (when method '(:codex-auth-source ende :codex-session-id "fixture-session"))))))

(defun ende-responses-ws-test--open (process)
  "Complete PROCESS's asynchronous TLS and fragmented HTTP Upgrade."
  (when (process-live-p process)
    (process-put process :fixture-status 'open)
    (funcall (process-sentinel process) process "open")
    (when-let* ((socket (process-get process :websocket)))
      (let* ((header (websocket-get-server-response socket nil nil))
             (split (/ (length header) 2)))
        (funcall (process-filter process) process (substring header 0 split))
        (should-not (ende-responses-ws-test--socket-sent process))
        (funcall (process-filter process) process (substring header split))))))

(defun ende-responses-ws-test--event (process text)
  "Deliver a real unmasked JSON frame from PROCESS."
  (funcall (process-filter process) process
           (websocket-encode-frame
            (make-websocket-frame :opcode 'text :payload (encode-coding-string text 'utf-8) :completep t) nil)))

(defun ende-responses-ws-test--complete (socket &optional id output)
  "Complete SOCKET with response ID and JSON OUTPUT."
  (ende-responses-ws-test--event
   socket (format "{\"type\":\"response.completed\",\"response\":{\"id\":\"%s\",\"output\":%s}}"
                  (or id "resp-fixture") (or output "[]"))))

(defun ende-responses-ws-test--image-round ()
  "Smoke-test generated image preparation, recovery and redacted wire capture."
  (when (or (executable-find "rsvg-convert") (executable-find "convert"))
    (ende-responses-ws-test--with-sockets
      (let* ((directory (make-temp-file "ende-ws-image-" t))
             (ende-debugging-enabled t)
             (ende-debug-provider-cache-comparisons nil)
             (ende-debug--session-directory directory)
             (ende-debug--sequence 0)
             (ende-debug--baselines (make-hash-table :test #'equal))
             (profile (ende-responses-ws-test--profile 1))
             (messages '(("user" . "Inspect this image")))
             (errors nil) (done 0)
             (callbacks (list :on-done (lambda (_) (cl-incf done))
                              :on-error (lambda (error) (push error errors)))))
        (unwind-protect
            (with-temp-buffer
              (setq buffer-file-name (expand-file-name "chat.org" directory))
              (let* ((base (ende-artifact-base))
                     (name (ende-artifact-store
                            base "fixture"
                            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"2\" height=\"2\"><rect width=\"2\" height=\"2\" fill=\"blue\"/></svg>"
                            "image/svg+xml"))
                     (image (ende-artifact-resolve base "fixture" name)))
                (ende-llm-default messages callbacks profile)
                (ende-responses-ws-test--open (car sockets))
                (ende-responses-ws-test--complete (car sockets) "resp_before_image")
                (let ((socket (car sockets)))
                  (setq messages (append messages (list (list :role "user" :content (list image)))))
                  (ende-llm-default messages callbacks profile)
                  (ende-test--wait-for (lambda () (or errors (= (length (ende-responses-ws-test--socket-sent socket)) 2))))
                  (should-not errors)
                  (let ((wire (car (ende-responses-ws-test--socket-sent socket))))
                    (should (equal (gethash "previous_response_id" wire) "resp_before_image"))
                    (should (= (length (gethash "input" wire)) 1))
                    (should (string-match-p "data:image/png;base64," (json-encode wire))))
                  (ende-responses-ws-test--event
                   socket "{\"type\":\"error\",\"error\":{\"code\":\"previous_response_not_found\"}}")
                  (ende-test--wait-for (lambda () (or errors (= (length (ende-responses-ws-test--socket-sent socket)) 3))))
                  (should-not errors)
                  (let ((wire (car (ende-responses-ws-test--socket-sent socket))))
                    (should-not (gethash "previous_response_id" wire))
                    (should (= (length (gethash "input" wire)) 2)))
                  (ende-responses-ws-test--complete socket "resp_after_image")
                  (setq messages (append messages '(("user" . "Continue"))))
                  (ende-llm-default messages callbacks profile)
                  (ende-test--wait-for (lambda () (or errors (= (length (ende-responses-ws-test--socket-sent socket)) 4))))
                  (should-not errors)
                  (let ((wire (car (ende-responses-ws-test--socket-sent socket))))
                    (should (equal (gethash "previous_response_id" wire) "resp_after_image"))
                    (should (= (length (gethash "input" wire)) 1)))
                  (ende-responses-ws-test--complete socket)
                  (should (= done 3))
                  (let ((incremental (ende-protocol-json-read-string
                                      (ende-artifact--read-bytes (expand-file-name "0002-request.json" directory))))
                        (recovery (ende-protocol-json-read-string
                                   (ende-artifact--read-bytes (expand-file-name "0003-request.json" directory)))))
                    (should (equal (gethash "previous_response_id" incremental) "resp_before_image"))
                    (should-not (gethash "previous_response_id" recovery))
                    (should (= (length (gethash "input" recovery)) 2))
                    (should-not (string-match-p "base64\\|fixture-api-key" (json-encode incremental)))))))
          (ende-responses-ws-close-all)
          (delete-directory directory t))))))

(ert-deftest ende-responses-ws-conversation-continuity ()
  :tags '(integration)
  (ende-responses-ws-test--image-round)
  (ende-responses-ws-test--with-sockets
    (let ((profile (plist-put (ende-responses-ws-test--profile 1) :parameters
                              '(:custom (:enabled :json-false :none nil))))
          (messages '(("user" . "Inspect the failing test")))
          (round 0) (errors nil) callbacks)
      (setq callbacks
            (list :on-error (lambda (error) (push error errors))
                  :on-done
                  (lambda (result)
                    (cl-incf round)
                    (setq messages
                          (append messages
                                  (list (list :role "assistant" :protocol-items (plist-get result :protocol-items))
                                        (list :tool-call-id (format "call_%s" round) :content "result"))))
                    (when (< round 3)
                      (setq profile (plist-put profile :parameters '(:custom (:none nil :enabled :json-false))))
                      (ende-llm-default messages callbacks profile)))))
      (ende-llm-default messages callbacks profile)
      (ende-responses-ws-test--open (car sockets))
      (dotimes (index 3)
        (let* ((number (1+ index))
               (wire (car (ende-responses-ws-test--socket-sent (car sockets))))
               (input (gethash "input" wire)))
          (should (= (length sockets) 1))
          (should (= (length input) 1))
          (if (= number 1)
              (should-not (gethash "previous_response_id" wire))
            (should (equal (gethash "previous_response_id" wire) (format "resp_%s" index)))
            (should (equal (gethash "type" (aref input 0)) "function_call_output"))
            (should (equal (gethash "call_id" (aref input 0)) (format "call_%s" index))))
          (ende-responses-ws-test--complete
           (car sockets) (format "resp_%s" number)
           (format "[{\"type\":\"reasoning\",\"id\":\"rs_%s\",\"encrypted_content\":\"opaque\",\"summary\":[],\"custom\":{\"a\":false,\"b\":null}},{\"type\":\"message\",\"id\":\"msg_%s\",\"role\":\"assistant\",\"phase\":\"commentary\",\"content\":[{\"type\":\"output_text\",\"text\":\"Checking\"}]},{\"type\":\"function_call\",\"id\":\"fc_%s\",\"call_id\":\"call_%s\",\"name\":\"read_file\",\"arguments\":\"{}\",\"status\":\"completed\"}]"
                   number number number number))))
      (should (= round 3))
      (let ((callbacks (list :on-error (lambda (error) (push error errors)))))
        (setq profile (plist-put profile :parameters '(:custom (:none nil :enabled nil))))
        (ende-llm-default messages callbacks profile)
        (let ((wire (car (ende-responses-ws-test--socket-sent (car sockets)))))
          (should-not (gethash "previous_response_id" wire))
          (should (= (length (gethash "input" wire)) 13))
          (should (equal (gethash "phase" (aref (gethash "input" wire) 2)) "commentary"))
          (should (equal (gethash "encrypted_content" (aref (gethash "input" wire) 1)) "opaque")))
        (ende-responses-ws-test--complete (car sockets) "resp_changed")
        (ende-llm-default '(("user" . "Compacted history")) callbacks profile)
        (let ((wire (car (ende-responses-ws-test--socket-sent (car sockets)))))
          (should-not (gethash "previous_response_id" wire))
          (should (= (length (gethash "input" wire)) 1))))
      (should-not errors))))

(ert-deftest ende-responses-ws-ownership-and-protocols ()
  (ende-responses-ws-test--with-sockets
    (let* ((default-directory "/ssh:fixture:/project/")
           (profile (ende-responses-ws-test--profile 1 'title))
           (done 0) (failed 0)
           (callbacks (list :on-done (lambda (_) (cl-incf done))
                            :on-error (lambda (_) (cl-incf failed)))))
      (ende-llm-default '(("user" . "Hello λ")) callbacks profile)
      (should (= (length sockets) 1))
      (ende-responses-ws-test--open (car sockets))
      (let ((wire (car (ende-responses-ws-test--socket-sent (car sockets)))))
        (should (equal (gethash "type" wire) "response.create"))
        (should (eq (gethash "store" wire) :false))
        (should-not (gethash "stream" wire))
        (should-not (gethash "background" wire))
        (should (equal (gethash "include" wire) ["reasoning.encrypted_content"]))
        (should (string-match-p "Hello λ" (json-encode wire))))
      (ende-responses-ws-test--complete (car sockets))
      (should (= done 1))
      (ende-llm-default '(("user" . "Again")) callbacks profile)
      (should (= (length sockets) 1))
      (ende-responses-ws-test--complete (car sockets))
      (setq profile (plist-put profile :request-phase 'work))
      (let ((old (car sockets)))
        (ende-llm-default '(("user" . "Work")) callbacks profile)
        (should-not (ende-responses-ws-test--socket-open old)))
      (ende-responses-ws-test--open (car sockets))
      (ende-responses-ws-test--complete (car sockets))
      (setq token "rotated-fixture-key")
      (ende-llm-default '(("user" . "Fresh credentials")) callbacks profile)
      (should (= (length sockets) 3))
      (ende-responses-ws-test--open (car sockets))
      (ende-responses-ws-test--complete (car sockets))
      (ende-llm-default '(("user" . "Other job")) callbacks (ende-responses-ws-test--profile 2))
      (should (= (length sockets) 4))
      (ende-responses-ws-test--open (car sockets))
      (ende-responses-ws-test--complete (car sockets))
      (dolist (method '(chatgpt-plan-oauth codex-oauth))
        (ende-llm-default '(("user" . "OAuth")) callbacks (ende-responses-ws-test--profile nil nil method))
        (ende-responses-ws-test--open (car sockets))
        (let* ((socket (car sockets))
               (headers (plist-get (ende-responses-ws-test--socket-options socket) :custom-header-alist))
               (wire (car (ende-responses-ws-test--socket-sent socket))))
          (should (assoc "Authorization" headers))
          (should (eq (gethash "stream" wire) (eq method 'codex-oauth)))
          (if (eq method 'codex-oauth)
              (progn
                (should (equal (cdr (assoc "OpenAI-Beta" headers)) "responses_websockets=2026-02-06"))
                (should (assoc "ChatGPT-Account-Id" headers)))
            (should-not (assoc "OpenAI-Beta" headers)))
          (ende-responses-ws-test--complete socket)
          (should-not (ende-responses-ws-test--socket-open socket))))
      (should (= done 7))
      (should (= failed 0)))))

(defun ende-responses-ws-test--recoveries ()
  "Exercise the shared recovery budget through public request callbacks."
  (ende-responses-ws-test--with-sockets
    (let* ((profile (plist-put (ende-responses-ws-test--profile 1) :request-timeout 1))
           (messages '(("user" . "First") ("user" . "Second")))
           (errors nil) (events nil) (done 0)
           (callbacks (list :on-done (lambda (_) (cl-incf done))
                            :on-error (lambda (error) (push error errors))
                            :on-event (lambda (event) (push event events))))
           (missing "{\"type\":\"error\",\"error\":{\"code\":\"previous_response_not_found\"}}")
           (limit "{\"type\":\"error\",\"error\":{\"code\":\"websocket_connection_limit_reached\"}}"))
      (ende-llm-default (butlast messages) callbacks profile)
      (ende-responses-ws-test--open (car sockets))
      (ende-responses-ws-test--complete (car sockets) "resp_first")
      (ende-llm-default messages callbacks profile)
      (let* ((request (ende-responses-ws-connection-active (gethash 1 ende-responses-ws--connections)))
             (deadline (ende-responses-ws-request-deadline-timer request)))
        (should (gethash "previous_response_id" (car (ende-responses-ws-test--socket-sent (car sockets)))))
        (ende-responses-ws-test--event (car sockets) missing)
        (should (eq deadline (ende-responses-ws-request-deadline-timer request)))
        (should (= (length sockets) 1))
        (let ((wire (car (ende-responses-ws-test--socket-sent (car sockets)))))
          (should-not (gethash "previous_response_id" wire))
          (should (= (length (gethash "input" wire)) 2)))
        (ende-responses-ws-test--event (car sockets) limit)
        (should (= (length errors) 1))
        (should (= (length sockets) 1)))
      (ende-llm-default messages callbacks profile)
      (ende-responses-ws-test--open (car sockets))
      (let ((old (car sockets)))
        (ende-responses-ws-test--event old limit)
        (should (= (length sockets) 3))
        (should-not (ende-responses-ws-test--socket-open old))
        (ende-responses-ws-test--open (car sockets))
        (ende-responses-ws-test--complete old)
        (should (= done 1))
        (ende-responses-ws-test--complete (car sockets) "resp_recovered")
        (should (= done 2)))
      (ende-llm-default messages callbacks profile)
      (let ((socket (car sockets)))
        (ende-responses-ws-test--event
         socket "{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"type\":\"function_call\",\"call_id\":\"observed\",\"name\":\"read_file\",\"arguments\":\"{}\"}}")
        (let ((sent (length (ende-responses-ws-test--socket-sent socket))))
          (ende-responses-ws-test--event socket missing)
          (should (= (length (ende-responses-ws-test--socket-sent socket)) sent))
          (should (= (length errors) 2))
          (should (cl-find :partial-result events :key (lambda (event) (plist-get event :type)))))))))

(ert-deftest ende-responses-ws-failure-lifecycle ()
  (ende-responses-ws-test--recoveries)
  (ende-responses-ws-test--with-sockets
    (let ((done 0) (errors nil) (events nil) cancel)
      (let ((callbacks (list :on-start (lambda (function) (setq cancel function))
                             :on-event (lambda (event) (push event events))
                             :on-done (lambda (_) (cl-incf done))
                             :on-error (lambda (error) (push error errors))))
            (profile (ende-responses-ws-test--profile 1)))
        (ende-llm-default '(("user" . "Hello")) callbacks profile)
        (ende-responses-ws-test--open (car sockets))
        (ende-responses-ws-test--event (car sockets) "{\"type\":\"response.output_text.delta\",\"delta\":\"partial\"}")
        (let ((old (car sockets)))
          (funcall cancel)
          (ende-responses-ws-test--complete old)
          (should (= (length errors) 1))
          (should (cl-find :partial-result events :key (lambda (event) (plist-get event :type))))
          (ende-llm-default '(("user" . "Next")) callbacks profile)
          (ende-responses-ws-test--open (car sockets))
          (ende-responses-ws-test--event old "{\"type\":\"response.output_text.delta\",\"delta\":\"late\"}")
          (let* ((bytes (encode-coding-string "{\"type\":\"response.output_text.delta\",\"delta\":\"λ\"}" 'utf-8))
                 (split (1+ (string-match (encode-coding-string "λ" 'utf-8) bytes)))
                 (socket (car sockets))
                 (callback (plist-get (ende-responses-ws-test--socket-options socket) :on-message)))
            (funcall callback socket (make-websocket-frame :opcode 'text :payload (substring bytes 0 split)))
            (funcall callback socket (make-websocket-frame :opcode 'continuation :completep t
                                                           :payload (substring bytes split)))
            (should (cl-find "λ" events :key (lambda (event) (plist-get event :text)) :test #'equal)))
          (ende-responses-ws-test--complete (car sockets))
          (should (= done 1)))
        (ende-llm-default '(("user" . "Closed")) callbacks profile)
        (funcall (plist-get (ende-responses-ws-test--socket-options (car sockets)) :on-close)
                 (car sockets))
        (should (= (length sockets) 2))
        (should (= (length errors) 2))
        (should (= (hash-table-count ende-responses-ws--connections) 0))
        (let ((ende-max-response-bytes 1))
          (ende-llm-default '(("user" . "Bounded")) callbacks profile)
          (ende-responses-ws-test--open (car sockets))
          (ende-responses-ws-test--complete (car sockets))
          (should (eq (ende-error-kind (car errors)) 'resource)))
        (let ((ende-connect-timeout nil)
              (ende-response-idle-timeout 0.02))
          (ende-llm-default '(("user" . "Timeout")) callbacks profile)
          (ende-responses-ws-test--open (car sockets))
          (ende-test--wait-for (lambda () (= (length errors) 4))))
        (should (= done 1))
        (setq opening (lambda (_process) (funcall cancel)))
        (ende-llm-default '(("user" . "Cancel during open")) callbacks profile)
        (setq opening nil)
        (should (= (length errors) 5))
        (ende-responses-ws-test--open (car sockets))
        (should-not (ende-responses-ws-test--socket-open (car sockets)))
        (should (= (hash-table-count ende-responses-ws--connections) 0))
        (ende-llm-default '(("user" . "Shutdown"))
                          (list :on-error (lambda (_)
                                            (ende-llm-default '(("user" . "Reentrant"))
                                                              callbacks profile))) profile)
        (ende-responses-ws-close-all)
        (should (= (hash-table-count ende-responses-ws--connections) 0))
        (dolist (input `((upgrading ,(make-string 257 ?a) resource)
                         (upgrading "HTTP/1.1 403 Forbidden\r\n\r\n" transport)
                         (upgrading "HTTP/1.1 101 Switching Protocols\r\n\r\n" transport)
                         (open ,(unibyte-string #x81 126 1 0) resource)
                         (open ,(unibyte-string #x89 126) protocol)
                         (open ,(unibyte-string #x09 0) protocol)))
          (pcase-let ((`(,state ,bytes ,kind) input)
                      (before (length errors))
                      (ende-max-response-header-bytes 256)
                      (ende-max-sse-event-bytes 32))
            (ende-llm-default '(("user" . "Raw input ceiling")) callbacks profile)
            (let ((process (car sockets)))
              (should-not (process-get process :fixture-upgrade))
              (should-not (process-get process :fixture-sent))
              (if (eq state 'open)
                  (ende-responses-ws-test--open process)
                (process-put process :fixture-status 'open)
                (funcall (process-sentinel process) process "open")
                (funcall (process-sentinel process) process "open again"))
              (funcall (process-filter process) process bytes)
              (should (= (length errors) (1+ before)))
              (should (eq (ende-error-kind (car errors)) kind))
              (when (eq state 'upgrading)
                (should-not (process-get process :fixture-sent))
                (should (eq (plist-get (ende-error-details (car errors)) :transport-phase) 'upgrading))))))))))

(ert-deftest ende-responses-ws-reload-cleans-active-and-idle ()
  (ende-responses-ws-test--with-sockets
    (let ((callbacks (list :on-error #'ignore :on-done #'ignore)))
      (ende-llm-default '(("user" . "Idle")) callbacks (ende-responses-ws-test--profile 1))
      (ende-responses-ws-test--open (car sockets))
      (ende-responses-ws-test--complete (car sockets))
      (ende-llm-default '(("user" . "Active")) callbacks (ende-responses-ws-test--profile 2))
      (ende-responses-ws-test--open (car sockets))
      (dotimes (_ 2) (ende-reload))
      (should (= (hash-table-count ende-responses-ws--connections) 0))
      (should-not (cl-some #'ende-responses-ws-test--socket-open sockets))
      (should (= (cl-count #'ende--responses-job-event ende-job-event-functions) 1))
      (should (= (cl-count #'ende-responses-ws-close-all ende-queue-abort-functions) 1))
      (cl-letf (((symbol-function 'ende-credentials-secret) (lambda (_) token)))
        (let (done)
          (ende-llm-default '(("user" . "After reload")) (list :on-done (lambda (_) (setq done t)))
                            (ende-responses-ws-test--profile))
          (ende-responses-ws-test--open (car sockets))
          (ende-responses-ws-test--complete (car sockets))
          (should done)
          (should (= (hash-table-count ende-responses-ws--connections) 0)))))))

