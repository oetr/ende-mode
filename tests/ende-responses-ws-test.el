;; Adapter conversations over a real local listener; transport parsing has its
;; own tests in ende-websocket-test.el.
;;; Code:

(require 'ert)
(require 'ende)
(require 'ende-test-wait)
(require 'ende-test-helpers)

(defmacro ende-responses-ws-test--with-server (&rest body)
  "Run BODY with real local sockets and deterministic authentication."
  (declare (indent 0) (debug t))
  `(let ((ende-responses-ws--connections (make-hash-table :test #'equal))
         (ende-provider-discovery-enabled nil)
         (ende-debugging-enabled nil)
         (sockets nil) (wires nil) (headers nil) (clients nil)
         (token "fixture-api-key")
         (connect (symbol-function 'ende-websocket-connect)) listener)
     (setq listener
           (ende-websocket-listen
            :service t
            :admit (lambda (_socket request)
                     (push (plist-get request :headers) headers)
                     '(:accept t))
            :on-open (lambda (socket) (push socket sockets))
            :on-message (lambda (socket type text)
                          (should (eq type 'text))
                          (push (cons socket (ende-protocol-json-read-string text)) wires))))
     (cl-letf (((symbol-function 'ende-responses-ws--retry-delay) (lambda (_) 0))
               ((symbol-function 'ende-credentials-secret) (lambda (_) token))
               ((symbol-function 'ende-codex--resolve-auth)
                (lambda (callback profile)
                  (funcall callback
                           (list :auth-method (plist-get profile :auth-method)
                                 :account (plist-get profile :account)
                                 :registration-id "fixture-registration"
                                 :access-token token :client-id ende-codex-native-client-id
                                 :chatgpt-account-id "fixture-account"
                                 :scope "offline_access chatgpt.tokens.use.direct"))
                  nil))
               ((symbol-function 'ende-curl-start-request)
                (lambda (&rest _) (ert-fail "WebSocket fell back to HTTP")))
               ((symbol-function 'ende-websocket-connect)
                (lambda (url &rest options)
                  (should (string-prefix-p "wss://" url))
                  (should-not (file-remote-p default-directory))
                  (let ((socket (apply connect
                                       (format "ws://127.0.0.1:%d/responses"
                                               (ende-websocket-listener-port listener))
                                       options)))
                    (push socket clients)
                    socket))))
       (unwind-protect (progn ,@body)
         (ende-responses-ws-close-all)
         (dolist (socket clients) (ende-websocket-abort socket))
         (ende-websocket-stop-listener listener)))))

(defun ende-responses-ws-test--profile (&optional owner phase method)
  "Resolve a fixture connection for OWNER, PHASE and OAuth METHOD."
  (let* ((ende-providers nil) (ende-builtin-provider-settings nil) (ende-custom-providers nil)
         (profile (ende-provider-config-resolve
                   (if method 'openai-codex 'openai) "test-model" nil
                   (when method (list :auth-method method :account 'personal)))))
    (ende-plist-merge profile
                      (append (list :transport 'websocket :job-id owner :request-phase (or phase 'work))
                              (when method '(:codex-auth-source ende :codex-session-id "fixture-session"))))))

(defun ende-responses-ws-test--event (socket text)
  "Queue TEXT from the local server SOCKET."
  (ende-websocket-send-text socket text))

(defun ende-responses-ws-test--complete (socket &optional id output)
  "Complete SOCKET with response ID and JSON OUTPUT."
  (ende-responses-ws-test--event
   socket (format "{\"type\":\"response.completed\",\"response\":{\"id\":\"%s\",\"output\":%s}}"
                  (or id "resp-fixture") (or output "[]"))))

(ert-deftest ende-responses-ws-conversation-continuity ()
  :tags '(integration)
  (ende-responses-ws-test--with-server
    (let ((profile (ende-responses-ws-test--profile 1))
          (messages '(("user" . "Hello λ")))
          (done 0) errors result)
      (cl-labels ((submit ()
                    (ende-llm-default
                     messages (list :on-error (lambda (error) (push error errors))
                                    :on-done (lambda (value) (setq result value) (cl-incf done)))
                     profile)))
        (submit)
        (ende-test--wait-for (lambda () wires))
        (let ((wire (cdar wires)))
          (should (equal (gethash "type" wire) "response.create"))
          (should-not (gethash "stream" wire))
          (should (string-match-p "Hello λ" (json-encode wire)))
          (should-not (gethash "previous_response_id" wire)))
        (should (equal (cdr (assoc "authorization" (car headers))) "Bearer fixture-api-key"))
        (ende-responses-ws-test--complete
         (car sockets) "resp_1"
         "[{\"type\":\"function_call\",\"id\":\"fc_1\",\"call_id\":\"call_1\",\"name\":\"read_file\",\"arguments\":\"{}\",\"status\":\"completed\"}]")
        (ende-test--wait-for (lambda () (= done 1)))
        (setq messages (append messages
                               (list (list :role "assistant" :protocol-items (plist-get result :protocol-items))
                                     (list :tool-call-id "call_1" :content "result"))))
        (submit)
        (ende-test--wait-for (lambda () (= (length wires) 2)))
        (should (= (length sockets) 1))
        (let* ((wire (cdar wires)) (input (gethash "input" wire)))
          (should (equal (gethash "previous_response_id" wire) "resp_1"))
          (should (= (length input) 1))
          (should (equal (gethash "type" (aref input 0)) "function_call_output")))
        (ende-responses-ws-test--complete (car sockets) "resp_2")
        (ende-test--wait-for (lambda () (= done 2)))
        ;; Compaction invalidates continuation, not the owned connection.
        (setq messages '(("user" . "Compacted history")))
        (submit)
        (ende-test--wait-for (lambda () (= (length wires) 3)))
        (should-not (gethash "previous_response_id" (cdar wires)))
        (should (= (length sockets) 1))
        (ende-responses-ws-test--complete (car sockets) "resp_3")
        (ende-test--wait-for (lambda () (= done 3)))
        (should-not errors)))))

(ert-deftest ende-responses-ws-recovery-and-delivery ()
  :tags '(integration)
  (ende-responses-ws-test--with-server
    (let* ((profile (ende-responses-ws-test--profile 1))
           (messages '(("user" . "First")))
           (done 0) errors
           (callbacks (list :on-done (lambda (_) (cl-incf done))
                            :on-error (lambda (error) (push error errors)))))
      (ende-llm-default messages callbacks profile)
      (ende-test--wait-for (lambda () wires))
      (ende-responses-ws-test--complete (car sockets) "resp_seed")
      (ende-test--wait-for (lambda () (= done 1)))
      (setq messages (append messages '(("user" . "Next"))))
      (ende-llm-default messages callbacks profile)
      (ende-test--wait-for (lambda () (= (length wires) 2)))
      (should (gethash "previous_response_id" (cdar wires)))
      (let ((retired (car sockets)))
        (ende-responses-ws-test--event
         retired "{\"type\":\"error\",\"error\":{\"code\":\"previous_response_not_found\"}}")
        (ende-test--wait-for (lambda () (= (length wires) 3)))
        (should (= (length sockets) 2))
        (should-not (gethash "previous_response_id" (cdar wires)))
        (should (= (length (gethash "input" (cdar wires))) 2))
        (should (eq (ende-websocket-state retired) 'closed)))
      (ende-responses-ws-test--complete (car sockets) "resp_recovered")
      (ende-test--wait-for (lambda () (= done 2)))
      (should-not errors)
      ;; Accepted output is not safely replayable, even before any response.
      (ende-llm-default messages callbacks profile)
      (ende-test--wait-for (lambda () (= (length wires) 4)))
      (ende-websocket-abort (car sockets))
      (ende-test--wait-for (lambda () errors))
      (should (eq (ende-error-kind (car errors)) 'transport))
      (should (= (length sockets) 2))
      (should-not (gethash 1 ende-responses-ws--connections))))
  ;; Even acceptance with *no native transmission* is ambiguous: the public
  ;; API deliberately has no delivery acknowledgement for queued messages.
  (ende-responses-ws-test--with-server
    (let (accepted errors)
      (cl-letf (((symbol-function 'ende-websocket-send-text-bytes)
                 (lambda (_socket _bytes) (setq accepted t))))
        (ende-llm-default '(("user" . "Accepted, not transmitted"))
                          (list :on-error (lambda (error) (push error errors)))
                          (ende-responses-ws-test--profile 1))
        (ende-test--wait-for (lambda () accepted))
        (should-not wires)
        (ende-websocket-abort (car sockets))
        (ende-test--wait-for (lambda () errors))
        (should (eq (ende-error-kind (car errors)) 'transport))
        (should (= (length clients) 1))
        (should-not (gethash 1 ende-responses-ws--connections)))))
  ;; A rejected offer, unlike an accepted one, can safely use fresh auth and
  ;; a replacement connection after loss.  Retry counters remain request-wide.
  (ende-responses-ws-test--with-server
    (let ((send (symbol-function 'ende-websocket-send-text-bytes)) blocked errors)
      (cl-letf (((symbol-function 'ende-websocket-send-text-bytes)
                 (lambda (socket bytes)
                   (if blocked (funcall send socket bytes)
                     (setq blocked t)
                     (signal 'ende-websocket-backpressure nil)))))
        (ende-llm-default '(("user" . "Unsent"))
                          (list :on-error (lambda (error) (push error errors)))
                          (ende-responses-ws-test--profile 1))
        (ende-test--wait-for (lambda () blocked))
        (setq token "retry-key")
        (ende-websocket-abort (car sockets))
        (ende-test--wait-for (lambda () wires))
        (should (= (length clients) 2))
        (should (equal (cdr (assoc "authorization" (car headers))) "Bearer retry-key"))
        (should (= (ende-responses-ws-request-retries
                    (ende-responses-ws-connection-active (gethash 1 ende-responses-ws--connections))) 1))
        (ende-responses-ws-test--complete (car sockets))
        (ende-test--wait-for (lambda () (not (ende-responses-ws-connection-active
                                             (gethash 1 ende-responses-ws--connections)))))
        (should-not errors))))
  ;; Queue rejection is not delivery.  A writable callback may offer it once.
  (ende-responses-ws-test--with-server
    (let ((send (symbol-function 'ende-websocket-send-text-bytes)) blocked writable errors)
      (cl-letf (((symbol-function 'ende-websocket-send-text-bytes)
                 (lambda (socket bytes)
                   (if blocked (funcall send socket bytes)
                     (setq blocked t)
                     (signal 'ende-websocket-backpressure nil))))
                ((symbol-function 'ende-websocket-connect)
                 (let ((fixture (symbol-function 'ende-websocket-connect)))
                   (lambda (url &rest options)
                     (setq writable (plist-get options :on-writable))
                     (apply fixture url options)))))
        (ende-llm-default '(("user" . "Offer once"))
                          (list :on-error (lambda (error) (push error errors)))
                          (ende-responses-ws-test--profile 1))
        (ende-test--wait-for (lambda () blocked))
        (should-not wires)
        (let* ((connection (gethash 1 ende-responses-ws--connections))
               (request (ende-responses-ws-connection-active connection)))
          (should (eq (ende-responses-ws-request-delivery request) 'unsent))
          (funcall writable (ende-responses-ws-connection-socket connection))
          (ende-test--wait-for (lambda () wires))
          (should (eq (ende-responses-ws-request-delivery request) 'accepted))
          (funcall writable (ende-responses-ws-connection-socket connection))
          (should (= (length wires) 1)))
        (ende-responses-ws-test--complete (car sockets))
        (ende-test--wait-for (lambda () (not (ende-responses-ws-connection-active
                                             (gethash 1 ende-responses-ws--connections)))))
        (should-not errors)))))

(ert-deftest ende-responses-ws-ownership-and-lifecycle ()
  :tags '(integration)
  (ende-responses-ws-test--with-server
    (let* ((profile (ende-responses-ws-test--profile 1))
           (done 0) errors
           (callbacks (list :on-done (lambda (_) (cl-incf done))
                            :on-error (lambda (error) (push error errors)))))
      (let ((default-directory "/ssh:fixture:/project/"))
        (ende-llm-default '(("user" . "Hello")) callbacks profile))
      (ende-test--wait-for (lambda () wires))
      (ende-responses-ws-test--complete (car sockets))
      (ende-test--wait-for (lambda () (= done 1)))
      ;; Auth changes replace the idle socket and its lineage.
      (setq token "replacement-key")
      (ende-llm-default '(("user" . "Next")) callbacks profile)
      (ende-test--wait-for (lambda () (= (length wires) 2)))
      (should (= (length sockets) 2))
      (should-not (gethash "previous_response_id" (cdar wires)))
      (ende-responses-ws-test--complete (car sockets))
      (ende-test--wait-for (lambda () (= done 2)))
      ;; Ownerless success cannot retain a private socket.
      (ende-llm-default '(("user" . "Ephemeral")) callbacks
                        (ende-responses-ws-test--profile))
      (ende-test--wait-for (lambda () (= (length wires) 3)))
      (let ((ephemeral (car clients)))
        (ende-responses-ws-test--complete (car sockets))
        (ende-test--wait-for (lambda () (= done 3)))
        (should (eq (ende-websocket-state ephemeral) 'closed)))
      (should-not errors)
      (ende-llm-default '(("user" . "Cancel")) callbacks profile)
      (ende-responses-ws-close-owner 1)
      (should (= (length errors) 1))
      (should-not (gethash 1 ende-responses-ws--connections))
      (ende-responses-ws-close-all)
      (ende-responses-ws-close-all)
      (should (zerop (hash-table-count ende-responses-ws--connections)))))
  (ende-responses-ws-test--with-server
    (let ((done nil) errors)
      (ende-llm-default '(("user" . "OAuth headers"))
                        (list :on-done (lambda (_) (setq done t))
                              :on-error (lambda (error) (push error errors)))
                        (ende-responses-ws-test--profile 1 'work 'codex-oauth))
      (ende-test--wait-for (lambda () wires))
      (should (equal (cdr (assoc "authorization" (car headers))) "Bearer fixture-api-key"))
      (should (equal (cdr (assoc "chatgpt-account-id" (car headers))) "fixture-account"))
      (ende-responses-ws-test--complete (car sockets))
      (ende-test--wait-for (lambda () done))
      (should-not errors)))
  (ende-responses-ws-test--with-server
    (let ((ende-responses-ws-max-retries 1) errors)
      (ende-llm-default '(("user" . "Bounded recovery"))
                        (list :on-error (lambda (error) (push error errors)))
                        (ende-responses-ws-test--profile 1))
      (ende-test--wait-for (lambda () wires))
      (ende-responses-ws-test--event
       (car sockets) "{\"type\":\"error\",\"error\":{\"code\":\"websocket_connection_limit_reached\"}}")
      (ende-test--wait-for (lambda () (= (length wires) 2)))
      (ende-responses-ws-test--event
       (car sockets) "{\"type\":\"error\",\"error\":{\"code\":\"websocket_connection_limit_reached\"}}")
      (ende-test--wait-for (lambda () errors))
      (should (= (length clients) 2))
      (should (= (plist-get (ende-error-details (car errors)) :retries) 1))))
  (ende-responses-ws-test--with-server
    (let ((profile (plist-put (ende-responses-ws-test--profile 2) :request-timeout 0.05)) errors)
      (ende-llm-default '(("user" . "Deadline"))
                        (list :on-error (lambda (error) (push error errors))) profile)
      (ende-test--wait-for (lambda () errors))
      (should (eq (ende-error-kind (car errors)) 'timeout))
      (should-not (gethash 2 ende-responses-ws--connections)))))

(ert-deftest ende-responses-ws-owned-file-recovery ()
  :tags '(integration)
  (ende-responses-ws-test--with-server
    (let ((ende-request--worker-threshold 1)
          (send (symbol-function 'ende-websocket-send-text-file))
          files blocked writable done errors)
      (cl-letf (((symbol-function 'ende-websocket-send-text-bytes)
                 (lambda (&rest _) (ert-fail "File request used the string sender")))
                ((symbol-function 'ende-websocket-send-text-file)
                 (lambda (socket file &optional cleanup)
                   (should (file-exists-p file))
                   (cl-pushnew file files :test #'equal)
                   (if blocked (funcall send socket file cleanup)
                     (setq blocked t)
                     (signal 'ende-websocket-backpressure nil))))
                ((symbol-function 'ende-websocket-connect)
                 (let ((fixture (symbol-function 'ende-websocket-connect)))
                   (lambda (url &rest options)
                     (setq writable (plist-get options :on-writable))
                     (apply fixture url options)))))
        (ende-llm-default '(("user" . "Owned λ request"))
                          (list :on-done (lambda (_) (setq done t))
                                :on-error (lambda (error) (push error errors)))
                          (ende-responses-ws-test--profile 1))
        (ende-test--wait-for (lambda () blocked))
        (let* ((connection (gethash 1 ende-responses-ws--connections))
               (request (ende-responses-ws-connection-active connection))
               (full (plist-get (ende-request-retained-source
                                  (ende-responses-ws-request-logical-request request)) :full-file)))
          (should (file-exists-p full))
          (should (eq (ende-responses-ws-request-delivery request) 'unsent))
          (funcall writable (ende-responses-ws-connection-socket connection))
          (ende-test--wait-for (lambda () wires))
          (should-not (file-exists-p (car files)))
          (ende-responses-ws-test--event
           (car sockets) "{\"type\":\"error\",\"error\":{\"code\":\"previous_response_not_found\"}}")
          (ende-test--wait-for (lambda () (= (length wires) 2)))
          (should (= (length files) 2))
          (should (ende-protocol-json-equal-p (cdar wires) (cdadr wires)))
          (ende-responses-ws-test--complete (car sockets))
          (ende-test--wait-for (lambda () done))
          (should (file-exists-p full))
          (ende-responses-ws-close-owner 1)
          (dolist (file (cons full files)) (should-not (file-exists-p file)))
          (should-not errors))))))

(ert-deftest ende-responses-ws-bounds-and-debug-capture ()
  :tags '(integration)
  (dolist (event '("not JSON" "{\"missing\":\"type\"}"))
    (ende-responses-ws-test--with-server
      (let (errors)
        (ende-llm-default '(("user" . "Protocol"))
                          (list :on-error (lambda (error) (push error errors)))
                          (ende-responses-ws-test--profile 1))
        (ende-test--wait-for (lambda () wires))
        (ende-responses-ws-test--event (car sockets) event)
        (ende-test--wait-for (lambda () errors))
        (should (eq (ende-error-kind (car errors)) 'protocol))
        (should-not (string-match-p "fixture-api-key" (prin1-to-string errors))))))
  (ende-responses-ws-test--with-server
    (let ((ende-max-response-bytes 70) errors)
      (ende-llm-default '(("user" . "Bound"))
                        (list :on-error (lambda (error) (push error errors)))
                        (ende-responses-ws-test--profile 1))
      (ende-test--wait-for (lambda () wires))
      (dotimes (_ 3)
        (ende-responses-ws-test--event (car sockets) "{\"type\":\"response.in_progress\"}"))
      (ende-test--wait-for (lambda () errors))
      (should (eq (ende-error-kind (car errors)) 'resource))))
  (ende-responses-ws-test--with-server
    (let ((ende-max-sse-event-bytes 64) errors)
      (ende-llm-default '(("user" . "Event bound"))
                        (list :on-error (lambda (error) (push error errors)))
                        (ende-responses-ws-test--profile 1))
      (ende-test--wait-for (lambda () wires))
      (ende-responses-ws-test--event (car sockets) (make-string 80 ?x))
      (ende-test--wait-for (lambda () errors))
      (should (eq (ende-error-kind (car errors)) 'resource))))
  (ende-responses-ws-test--with-server
    (let ((ende-response-idle-timeout 0.05) errors)
      (ende-llm-default '(("user" . "Idle deadline"))
                        (list :on-error (lambda (error) (push error errors)))
                        (ende-responses-ws-test--profile 1))
      (ende-test--wait-for (lambda () errors))
      (should (eq (ende-error-kind (car errors)) 'timeout))
      (should (= (length clients) 1))))
  (ende-responses-ws-test--with-server
    (let* ((directory (make-temp-file "ende-ws-debug-" t))
           (ende-debugging-enabled t)
           (ende-debug-provider-cache-comparisons nil)
           (ende-debug--session-directory directory)
           (ende-debug--sequence 0)
           (ende-debug--baselines (make-hash-table :test #'equal))
           done errors)
      (unwind-protect
          (progn
            (ende-llm-default '(("user" . "Capture"))
                              (list :on-done (lambda (_) (setq done t))
                                    :on-error (lambda (error) (push error errors)))
                              (ende-responses-ws-test--profile 1))
            (ende-test--wait-for (lambda () wires))
            (let ((wire (ende-protocol-json-read-string
                         (ende-artifact--read-bytes (expand-file-name "0001-request.json" directory)))))
              (should (equal (gethash "type" wire) "response.create"))
              (should-not (gethash "previous_response_id" wire))
              (should-not (string-match-p "fixture-api-key" (json-encode wire))))
            (ende-responses-ws-test--complete (car sockets))
            (ende-test--wait-for (lambda () done))
            (should-not errors))
        (delete-directory directory t)))))

(provide 'ende-responses-ws-test)
