;;; websocket-test.el --- WebSocket behavioral checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(load (expand-file-name "../websocket.el"
                        (file-name-directory (or load-file-name buffer-file-name)))
      nil t t)

(ert-deftest websocket-codec ()
  (should (equal (websocket--accept "dGhlIHNhbXBsZSBub25jZQ==")
                 "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="))
  (let* ((wire (unibyte-string #x81 #x85 #x37 #xfa #x21 #x3d
                               #x7f #x9f #x4d #x51 #x58))
         (header (websocket--frame-header wire 'server 1024))
         (frame (cdr header)))
    (should (= (car header) 6))
    (should (equal (websocket--mask! (substring wire 6)
                                    (websocket--frame-mask frame) 0) "Hello"))
    (should-error (websocket--frame-header wire 'client 1024)
                  :type 'websocket-protocol-error))
  (dolist (bytes (list (unibyte-string #x81 #x7e 0 1)
                       (unibyte-string #x89 #x7e 0 126)
                       (unibyte-string #xc1 0)
                       (unibyte-string #x83 0)))
    (should-error (websocket--frame-header bytes 'client 1024)
                  :type 'websocket-protocol-error))
  (should-error (websocket--text (unibyte-string 255)) :type 'websocket-invalid-utf8)
  (dolist (text '("" "Hello" "ÿ" "\ufeff\r\nλ😀"))
    (let ((bytes (websocket--text text)))
      (dotimes (split (1+ (length bytes)))
        (let ((state (websocket--utf8-create)))
          (websocket--utf8-feed state (substring bytes 0 split))
          (websocket--utf8-feed state (substring bytes split) t)))
      (should (equal text (decode-coding-string bytes 'utf-8-unix)))))
  (dolist (bytes (list '(#xc0 #x80) '(#xed #xa0 #x80) '(#xf4 #x90 #x80 #x80)
                       '(#x80) '(#xe0 #x9f #xbf) '(#xf0 #x8f #xbf #xbf) '(#xc2)))
    (setq bytes (apply #'unibyte-string bytes))
    (dotimes (split (1+ (length bytes)))
      (should-error
       (let ((state (websocket--utf8-create)))
         (websocket--utf8-feed state (substring bytes 0 split))
         (websocket--utf8-feed state (substring bytes split) t))
       :type 'websocket-invalid-utf8))))

(defun websocket-test--http (wire)
  (let ((http (websocket--http-create)))
    (dolist (line (butlast (split-string wire "\r\n")))
      (websocket--http-line http line websocket--default-limits))
    http))

(ert-deftest websocket-opening-boundary ()
  (let* ((key "dGhlIHNhbXBsZSBub25jZQ==")
         (address (websocket--url "ws://[::1]:8080?x=%20"))
         (request (websocket--client-request address key '("chat") '(("Origin" . "null"))))
         (http (websocket-test--http request)))
    (should (equal (plist-get address :target) "/?x=%20"))
    (should (equal (plist-get (websocket--server-request http) :origin) "null"))
    (push '("host" . "other") (websocket--http-fields http))
    (should-error (websocket--server-request http) :type 'websocket-protocol-error)
    (dolist (extra '("" "Sec-WebSocket-Protocol: chat\r\n"))
      (should (member
               (websocket--client-response
                (websocket-test--http
                 (concat "HTTP/1.1 101 Switching Protocols\r\nConnection: keep-alive, Upgrade\r\n"
                         "Upgrade: WebSocket\r\nSec-WebSocket-Accept: " (websocket--accept key)
                         "\r\n" extra "\r\n")) key '("chat")) '(nil "chat"))))
    (dolist (extra '("Sec-WebSocket-Accept: bad\r\n" "Sec-WebSocket-Protocol: other\r\n"
                     "Sec-WebSocket-Extensions: compress\r\n"))
      (should-error
       (websocket--client-response
        (websocket-test--http
         (concat "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n"
                 "Sec-WebSocket-Accept: " (websocket--accept key) "\r\n" extra "\r\n")) key '("chat"))
       :type 'websocket-protocol-error)))
  (dolist (url '("http://host/" "ws://host/#fragment" "ws://user:secret@host/"
                 "ws://host:0/" "ws://host/a b" "ws://host/%2" "ws://host/%gg"))
    (should-error (websocket--url url)))
  (dolist (line '(" Host: example" "Host : example" "Host: x\rInjected: yes"))
    (should-error (websocket-test--http (concat "GET / HTTP/1.1\r\n" line "\r\n\r\n"))
                  :type 'websocket-protocol-error)))

(defmacro websocket-test--connection (binding &rest body)
  (declare (indent 1))
  `(let* ((,binding (websocket--new 'client (websocket--limits nil) nil))
          (process (make-pipe-process :name "websocket-test" :noquery t :coding 'binary)))
     (setf (websocket--connection-state ,binding) 'open
           (websocket--connection-process ,binding) process)
     (set-process-plist process (list 'websocket--connection ,binding 'websocket--generation 0))
     (unwind-protect (progn ,@body)
       (websocket-abort ,binding)
       (websocket--dispatch ,binding))))

(defun websocket-test--drain (connection)
  (when (websocket--connection-work-timer connection)
    (cancel-timer (websocket--connection-work-timer connection))
    (setf (websocket--connection-work-timer connection) nil))
  (websocket--run connection))

(ert-deftest websocket-message-semantics ()
  (let ((wire (unibyte-string 1 1 #xe2 #x89 1 42 #x80 2 #x82 #xac #x82 3 0 255 13 #x88 2 3 #xe8)))
    (dotimes (split (1+ (length wire)))
      (websocket-test--connection connection
        (let (messages writes)
          (setf (websocket--connection-callbacks connection)
                (list :on-message (lambda (_ type message) (push (list type message) messages))))
          (cl-letf (((symbol-function 'process-send-string)
                     (lambda (_ bytes) (push bytes writes))))
            (dolist (chunk (list (substring wire 0 split) (substring wire split)))
              (websocket--filter process chunk)
              (websocket-test--drain connection))
            (while (websocket--connection-work-timer connection)
              (websocket-test--drain connection)))
          (should (equal (nreverse messages) (list '(text "€") (list 'binary (unibyte-string 0 255 13)))))
          (should (= (length writes) 2))))))
  (websocket-test--connection connection
    (websocket--filter process (unibyte-string 1 1 #xe2 #x80 1 #x41))
    (websocket-test--drain connection)
    (should (eq (plist-get (websocket--connection-failure connection) :cause) 'utf8))))

(ert-deftest websocket-lifecycle-and-bounds ()
  (websocket-test--connection connection
    (let (messages)
      (setf (websocket--connection-callbacks connection)
            (list :on-message (lambda (_ _type message) (push message messages))))
      (websocket-send-binary connection "out")
      (cl-letf (((symbol-function 'process-send-string)
                 (lambda (_ _bytes) (websocket--filter process (unibyte-string #x82 1 42)))))
        (websocket-test--drain connection))
      (should (timerp (websocket--connection-work-timer connection)))
      (websocket-test--drain connection)
      (should (equal messages '("*")))))
  (websocket-test--connection connection
    (let ((closed 0) info)
      (setf (websocket--connection-callbacks connection)
            (list :on-close (lambda (_ terminal) (cl-incf closed) (setq info terminal))))
      (websocket-abort connection)
      (websocket-abort connection)
      (websocket--filter process (unibyte-string #x81 1 65))
      (websocket-test--drain connection)
      (should (= closed 1))
      (should (eq (plist-get info :cause) 'abort))
      (should-not (websocket--connection-input connection))))
  (websocket-test--connection connection
    (setf (websocket--connection-limits connection)
          (websocket--limits '(:output-bytes 3 :output-items 1)))
    (let ((bytes (unibyte-string 1 2 3)))
      (websocket-send-binary connection bytes)
      (aset bytes 0 255)
      (should-error (websocket-send-binary connection "") :type 'websocket-backpressure)
      (should (equal (websocket--output-bytes (car (websocket--connection-output connection)))
                     (unibyte-string 1 2 3)))
      (should (= (websocket--connection-output-items connection) 1))))
  (websocket-test--connection connection
    (setf (websocket--connection-limits connection)
          (websocket--limits '(:drain-frames 2 :frame-bytes 64 :write-frame-bytes 64)))
    (websocket--filter process (unibyte-string #x82 0 #x82 0 #x82 0))
    (websocket-test--drain connection)
    (should (timerp (websocket--connection-work-timer connection)))
    (should (= (with-current-buffer (websocket--connection-input connection) (buffer-size)) 2))
    (websocket-test--drain connection)
    (should (= (with-current-buffer (websocket--connection-input connection) (buffer-size)) 0))))

(defun websocket-test--wait (predicate)
  (let ((deadline (+ (float-time) 5)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should (funcall predicate))))

(ert-deftest websocket-transport-and-shutdown ()
  (unwind-protect
      (let* (received terminal client-returned server-open listener
             (_listener
              (setq listener (websocket-listen
               :service t
               :admit (lambda (_ request)
                        (should (equal (plist-get request :authority)
                                       (format "127.0.0.1:%d" (websocket-listener-port listener))))
                        (should-not (plist-get request :origin))
                        '(:accept t :protocol "echo"))
               :on-open (lambda (_) (setq server-open t))
               :on-message (lambda (c type message)
                             (if (eq type 'text) (websocket-send-text c message)
                               (websocket-send-binary c message))))))
             (client
              (websocket-connect
               (format "ws://127.0.0.1:%d" (websocket-listener-port listener))
               :protocols '("echo")
               :on-open (lambda (c)
                          (should client-returned)
                          (should (equal (websocket-protocol c) "echo"))
                          (websocket-send-text c "\ufeffλ\r\n😀"))
               :on-message (lambda (c type message)
                             (push (list type message) received)
                             (websocket-close c))
               :on-close (lambda (_ info) (setq terminal info)))))
        (setq client-returned t)
        (websocket-test--wait (lambda () terminal))
        (should server-open)
        (should (equal received '((text "\ufeffλ\r\n😀"))))
        (should (plist-get terminal :clean))
        (should (eq (websocket-state client) 'closed))
        (websocket-stop-listener listener))
    (websocket-shutdown))
  (should (= (hash-table-count websocket--connections) 0))
  (should (= (hash-table-count websocket--listeners) 0))
  (should-not websocket--opening-active)
  (should-not websocket--opening-queue)
  (websocket-shutdown))

;;; websocket-test.el ends here
